or m in re.finditer(c[\\"pattern\\"], text):\\n        candidates.append({\\"start\\":m.start(),\\"end\\":m.end(),\\"text\\":m.group(0),\\"category\\":c[\\"category\\"],\\n                           \\"classifier_id\\":c[\\"classifier_id\\"],\\"confidence\\":c[\\"thr\\"],\\"priority\\":c[\\"priority\\"]})\\n\\n# dictionary + heuristic PHI condition\\nfor t in condition_terms:\\n    for m in re.finditer(r\\"\\\\b\\"+re.escape(t)+r\\"\\\\b\\", text, flags=re.IGNORECASE):\\n        candidates.append({\\"start\\":m.start(),\\"end\\":m.end(),\\"text\\":m.group(0),\\"category\\":\\"PHI.HEALTH_DATA\\",\\n                           \\"classifier_id\\":\\"CLS-PHI-CONDITION-001\\",\\"confidence\\":condition_thr,\\"priority\\":condition_priority})\\n\\n# NER person approximation (deterministic): runs of Capitalized name tokens, excluding role-labeled fields\\n# Exclude any candidate preceded by a label like \\"User Role:\\" (role, not a person).\\nname_candidates=[]\\nfor m in re.finditer(r\\"\\\\b([A-Z][a-z]+(?:\\\\s+[A-Z][a-z]+){1,3})\\\\b\\", text):\\n    span_start=m.start()\\n    # find field label preceding on same line\\n    line_start=text.rfind(\\"\\\\n\\",0,span_start)+1\\n    label=text[line_start:span_start]\\n    # role exclusion\\n    if \\"User Role\\" in label:\\n        continue\\n    # crude role-word exclusion\\n    words=m.group(1).split()\\n    rolewords={\\"Senior\\",\\"Systems\\",\\"Administrator\\",\\"User\\",\\"Role\\",\\"Primary\\",\\"Phone\\",\\"Email\\",\\"Address\\",\\"Full\\",\\"Name\\",\\"System\\",\\"Username\\",\\"Last\\",\\"Login\\",\\"Passport\\",\\"Number\\"}\\n    if any(w in rolewords for w in words):\\n        continue\\n    name_candidates.append(m)\\nfor m in name_candidates:\\n    candidates.append({\\"start\\":m.start(),\\"end\\":m.end(),\\"text\\":m.group(1),\\"category\\":\\"PII.PERSON_NAME\\",\\n                       \\"classifier_id\\":\\"CLS-PII-NAME-001\\",\\"confidence\\":0.80,\\"priority\\":5})\\n\\n# Deterministic overlap resolution: start asc, length desc, priority asc, confidence desc; keep non-overlapping\\ncandidates_sorted=sorted(candidates, key=lambda x:(x[\\"start\\"], -(x[\\"end\\"]-x[\\"start\\"]), x[\\"priority\\"], -x[\\"confidence\\"]))\\nselected=[]\\nfor cand in candidates_sorted:\\n    if any(not(cand[\\"end\\"]<=s[\\"start\\"] or cand[\\"start\\"]>=s[\\"end\\"]) for s in selected):\\n        continue\\n    selected.append(cand)\\n\\nselected_sorted=sorted(selected, key=lambda x:x[\\"start\\"])\\nfor s in selected_sorted:\\n    s[\\"matched_text\\"]=s.pop(\\"text\\")\\n\\n# counts\\nfrom collections import Counter\\ncounts=Counter(s[\\"category\\"] for s in selected_sorted)\\n\\nresult={\\"total_detections\\":len(selected_sorted),\\n        \\"counts_per_category\\":dict(counts),\\n        \\"spans\\":[{k:sp[k] for k in [\\"start\\",\\"end\\",\\"matched_text\\",\\"category\\",\\"classifier_id\\",\\"confidence\\"]} for sp in selected_sorted]}\\nprint(json.dumps(result, indent=2))\\n"}}'}
