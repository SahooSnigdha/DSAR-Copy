\r\n# Sample data\r\nfile_name = "Arthur_P_Transcription.pdf"\r\ncontent = """\r\nUK CUSTOMER SUPPORT CALL TRANSCRIPT\r\nRECORD ID: REC-2026-UK-08421\r\nTIMESTAMP: 2026-10-19T14:30:00Z\r\nAGENT ID: AGENT_UK_512\r\nCUSTOMER NAME: Arthur Pendelton\r\nLOCATION: London, United Kingdom\r\nTranscript\r\n[14:30:12] Agent 512: Thank you for calling Metro Bank UK. My name is Oliver. Could I \r\nplease take your full name and your sort code and account number?\r\n[14:30:35] Arthur Pendelton: Right, hello Oliver. My name is Arthur Pendelton, and my sort \r\ncode is 40-22-04, account number is 89123456.\r\n[14:31:02] Agent 512: Brilliant, thank you Mr. Pendelton. Just for data protection and \r\nsecurity verification, could you confirm your date of birth and your full UK postcode?\r\n[14:31:25] Arthur Pendelton: Certainly. I was born on the 14th of July, 1974, and my \r\npostcode is SW1A 1AA.\r\n[14:31:50] Agent 512: Splendid, thank you very much for verifying that, Arthur. I\'ve located \r\nyour account. How can I assist you today?\r\n[14:32:10] Arthur Pendelton: I\'m calling about an unauthorized direct debit taken from my \r\naccount on the 15th of October for £89.50.\r\n[14:32:45] Agent 512: I am terribly sorry about that trouble, Arthur. I can see the direct \r\ndebit right here. I\'ll issue an immediate indemnity claim under the Direct Debit Guarantee \r\nand refund the £89.50 back to your account.\r\n[14:33:15] Arthur Pendelton: Excellent, thank you. Could you also update my contact mobile \r\nnumber on file to +44 7700 900077?\r\n[14:33:40] Agent 512: Consider it done, Arthur. I have updated your mobile number to +44 \r\n7700 900077 and sent a confirmation text. Anything else I can sort out for you?\r\n[14:34:02] Arthur Pendelton: No, that covers everything. Cheers for your help, Oliver.\r\n[14:34:15] Agent 512: You\'re most welcome, Arthur. Have a lovely afternoon. Cheerio!"""\r\n\r\n# Context-Exclusion Patterns\r\nexclusion_patterns = {\r\n    \'CLS-PHI-MED-ID-001\': r\'\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\b\',\r\n    \'CLS-PII-DOB-001\': r\'\\b(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])\\b\'\r\n}\r\n\r\n# Find sensitive information in the content\r\ndetections = []\r\nexclude_candidates = []\r\n\r\n# Detect and record PII/PHI occurrences\r\nfor cls_id, (pattern, category, confidence, priority) in patterns.items():\r\n    for match in re.finditer(pattern, content):\r\n        detection = {\r\n            "start": match.start(),\r\n            "end": match.end(),\r\n            "matched_text": match.group(1) if match.lastindex else match.group(),\r\n            "category": category,\r\n            "classifier_id": cls_id,\r\n            "confidence": confidence,\r\n            "location": "content"\r\n        }\r\n        detections.append(detection)\r\n\r\n# Handle context-exclusion checks\r\nfor pattern in exclusion_patterns.values():\r\n    for match in re.finditer(pattern, content):\r\n        exclude_candidates.append(match.group())\r\n\r\n# Identify excluded candidates\r\nexcluded_candidates = []\r\nif re.search(exclusion_patterns[\'CLS-PHI-MED-ID-001\'], "RECORD ID: REC-2026-UK-08421"):\r\n    excluded_candidates.append({"reason": "Log identifier context", "match": "REC-2026-UK-08421"})\r\nif re.search(exclusion_patterns[\'CLS-PII-DOB-001\'], "TIMESTAMP: 2026-10-19T14:30:00Z"):\r\n    excluded_candidates.append({"reason": "Administrative timestamp context", "match": "2026-10-19"})\r\n\r\n\r\n# Resolve overlapping detections\r\ndetections = sorted(detections, key=lambda x: (x[\'start\'], -x[\'end\']+x[\'start\'], x[\'classifier_id\'], -x[\'confidence\']))\r\nresolved_detections = []\r\nlast_end = -1\r\n\r\nfor detection in detections:\r\n    if detection[\'start\'] >= last_end:\r\n        resolved_detections.append(detection)\r\n        last_end = detection[\'end\']\r\n\r\n# Generate redacted filename\r\nfile_name_detections = []\r\nfor cls_id, pattern in patterns.items():\r\n    for match in re.finditer