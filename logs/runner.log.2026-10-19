CAL_IDENTIFIER.HEALTH_INSURANCE_MEMBER_ID", r\'\\b(?:HI|INS|POL|GRP)-[A-Za-z0-9-]{6,16}\\b\', 0.90, 2),\n    # Assume more classifiers as necessary...\n]\n\n# Define a manual NER list for PERSON_NAME\nperson_names = [\'Marcus Aurelius Vance\']\n\n# Function to apply regex classifiers and resolve overlaps\ndef apply_classifiers(text, file_name, classifiers, person_names):\n    # Find all matches in the text\n    matches = []\n    for cls_id, category, pattern, confidence, priority in classifiers:\n        for match in re.finditer(pattern, text):\n            matches.append({\n                \'start\': match.start(),\n                \'end\': match.end(),\n                \'category\': category,\n                \'classifier_id\': cls_id,\n                \'confidence\': confidence,\n                \'matched_text\': match.group(),\n                \'location\': \'content\'\n            })\n    \n    # Find person names\n    for name in person_names:\n        for match in re.finditer(re.escape(name), text):\n            matches.append({\n                \'start\': match.start(),\n                \'end\': match.end(),\n                \'category\': \'PII.PERSON_NAME\',\n                \'classifier_id\': \'CLS-PII-NAME-001\',\n                \'confidence\': 0.80,\n                \'matched_text\': match.group(),\n                \'location\': \'content\'\n            })\n\n    # Sort and resolve overlaps\n    matches.sort(key=lambda x: (x[\'start\'], -(x[\'end\'] - x[\'start\']), x[\'confidence\']), reverse=True)\n    resolved_matches = []\n    last_end = -1\n    for match in matches:\n        if match[\'start\'] >= last_end:\n            resolved_matches.append(match)\n            last_end = match[\'end\']\n    \n    # Scan file name for names and similar sensitive info\n    file_name_matches = []\n    for name in person_names:\n        if name in file_name:\n            start = file_name.index(name)\n            end = start + len(name)\n            file_name_matche