\\": \\"PII.IDENTIFIER.DRIVERS_LICENSE\\", \\"priority\\": 3, \\"threshold\\": 0.85, \\"regex\\": r\\"\\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b\\", \\"confidence\\": 0.88},\\n    \\"CLS-PII-ADDRESS-001\\": {\\"category\\": \\"PII.LOCATION.STREET_ADDRESS\\", \\"priority\\": 4, \\"threshold\\": 0.85, \\"regex\\": r\\"\\\\b\\\\d{1,5}[ \\\\t]+[A-Za-z0-9., \\\\t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \\\\t]+(?:Suite|Ste|Apt|Unit|#)[ \\\\t]+[A-Za-z0-9-]+)?,[ \\\\t]+[A-Za-z \\\\t]+,[ \\\\t]+[A-Z]{2}[ \\\\t]+\\\\d{5}(?:-\\\\d{4})?\\\\b|\\\\b\\\\d{1,5}[ \\\\t]+[A-Za-z0-9., \\\\t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \\\\t]+(?:Suite|Ste|Apt|Unit|#)[ \\\\t]+[A-Za-z0-9-]+)?\\\\b\\", \\"confidence\\": 0.89},\\n    \\"CLS-PHI-MED-ID-001\\": {\\"category\\": \\"PHI.MEDICAL_IDENTIFIER\\", \\"priority\\": 2, \\"threshold\\": 0.90, \\"regex\\": r\\"\\\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\\\b\\", \\"confidence\\": 0.92},\\n    \\"CLS-PHI-CONDITION-001\\": {\\"category\\": \\"PHI.HEALTH_DATA\\", \\"priority\\": 3, \\"threshold\\": 0.85, \\"terms\\": [\\"penicillin allergy\\", \\"allergy\\", \\"Hypertension\\", \\"hypertension\\", \\"prescription adjustment\\", \\"emergency dispensation\\", \\"medical dispensation\\"], \\"confidence\\": 0.87}\\n}\\n\\ncandidates = []\\ndef add_span(start, end, text_, category, classifier_id, confidence, priority):\\n    if end > start:\\n        candidates.append({\\"start\\": start, \\"end\\": end, \\"text\\": text_, \\"category\\": category, \\"classifier_id\\": classifier_id, \\"confidence\\": round(float(confidence), 2), \\"priority\\": priority})\\n\\nfor cid, spec in patterns.items():\\n    if \\"regex\\" not in spec:\\n        continue\\n    for m in re.finditer(spec[\\"regex\\"], text):\\n        if cid == \\"CLS-PII-DOB-001\\":\\n            context = text[max(0, m.start()-80):min(len(text), m.end()+80)].lower()\\n            if not any(k in context f