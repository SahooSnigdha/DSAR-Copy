NAL\r\n    ("ADDR_FINAL", "1200 Market Street Suite 400\\nSocial Security Number 123-45-6789", "1200 Market Street Suite 400"),\r\n    ("ADDR_FINAL", "742 Evergreen Terrace, Springfield, IL 62704\\nPhone: 555-0100", "742 Evergreen Terrace, Springfield, IL 62704"),\r\n    ("ADDR_FINAL", "500 West 5th Ave\\nNew York", "500 West 5th Ave"),\r\n    \r\n    # INS_FINAL\r\n    ("INS_FINAL", "HI-902849102-B", True),\r\n    ("INS_FINAL", "Member ID: HI-902849102-B on file", (11, 25)),\r\n    ("INS_FINAL", "AB-123456789-X", True),\r\n    ("INS_FINAL", "not an id HI-90284-B", False),\r\n    \r\n    # USER_FINAL\r\n    ("USER_FINAL", "Account: mavance_admin assigned; contact marcus.vance@example.com and see https://portal.example.com/mavance_admin and administrator", "mavance_admin"),\r\n    ("USER_FINAL", "Username: m.vance", "m.vance"),\r\n    ("USER_FINAL", "mavance_admin", False),\r\n]\r\n\r\n# Function to evaluate test cases\r\ndef evaluate_test_cases(patterns, test_cases):\r\n    results = []\r\n    for pattern_name, test_input, expected in test_cases:\r\n        pattern = re.compile(patterns[pattern_name])\r\n        match = pattern.search(test_input)\r\n        \r\n        if isinstance(expected, bool):\r\n            match_bool = match is not None\r\n            if expected and match:\r\n                result = (match.group(), match.span())\r\n            else:\r\n                result = (None, None)\r\n            pass_fail = "PASS" if match_bool == expected else "FAIL"\r\n        elif isinstance(expected, tuple):\r\n            if match:\r\n                result = match.span()\r\n            else:\r\n                result = None\r\n            pass_fail = "PASS" if result == expected else "FAIL"\r\n        else:  # expected is a string\r\n            result = match.group() if match else None\r\n            pass_fail = "PASS" if result == expected else "FAIL"\r\n        \r\n        results.append((pattern_name, test_input, result[0] if match else None, result[1] i