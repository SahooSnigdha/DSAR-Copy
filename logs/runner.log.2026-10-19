INANCIAL.CREDIT_CARD", "type": "regex", "priority": 1,\\r\\n     "threshold": 0.95, "conf": 0.99,\\r\\n     "pattern": r"\\\\b(?:4\\\\d{3}|5[1-5]\\\\d{2}|6011|3[47]\\\\d{2})[- ]?\\\\d{4}[- ]?\\\\d{4}[- ]?\\\\d{4}\\\\b|\\\\b\\\\d{4}-\\\\d{4}-\\\\d{4}-\\\\d{4}\\\\b"},\\r\\n    {"classifier_id": "CLS-PII-EMAIL-001", "category": "PII.CONTACT.EMAIL", "type": "regex", "priority": 2,\\r\\n     "threshold": 0.95, "conf": 0.99,\\r\\n     "pattern": r"\\\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}\\\\b"},\\r\\n    {"classifier_id": "CLS-PII-PHONE-001", "category": "PII.CONTACT.PHONE_NUMBER", "type": "regex", "priority": 2,\\r\\n     "threshold": 0.90, "conf": 0.97,\\r\\n     "pattern": r"(?:\\\\+?1[-. ]?)?(?:\\\\(\\\\d{3}\\\\)|\\\\b\\\\d{3})[-. ]?\\\\d{3}[-. ]?\\\\d{4}\\\\b"},\\r\\n    {"classifier_id": "CLS-PII-IP-001", "category": "PII.LOCATION.IP_ADDRESS", "type": "regex", "priority": 3,\\r\\n     "threshold": 0.90, "conf": 0.98,\\r\\n     "pattern": r"\\\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\b|\\\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\\\b"},\\r\\n    {"classifier_id": "CLS-PII-DOB-001", "category": "PII.DEMOGRAPHIC.DATE_OF_BIRTH", "type": "regex", "priority": 3,\\r\\n     "threshold": 0.85, "conf": 0.95,\\r\\n     "pattern": r"\\\\b(?:19|20)\\\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])\\\\b|\\\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\\\s+(?:0?[1-9]|[12]\\\\d|3[01]),\\\\s+(?:19|20)\\\\d{2}\\\\b"},\\r\\n    {"classifier_id": "CLS-PII-IBAN-001", "category": "PII.FINANCIAL.BANK_ACCOUNT", "type": "regex", "priority": 2,\\r\\n     "threshold": 0.90, "conf": 0.96,\\r\\n     "pattern": r"\\\\b[A-Z]{2}\\\\d{2}(?:\\\\s?[A-Z0-9]{4}){3,7}\\\\b"},\\r\\n    {"classifier_id": "CLS-PII-PASSPORT-001", "category": "PII.IDENTIFIER.PASSPORT", "type": "regex", "priority": 3,\\r\\n     "threshold": 0.85, "conf": 0.95, "pattern": r"\\\\b[A-Z]\\\\d{8,9}\\\\b"},\\r\\n    {"classifier_id": "CLS-PII-DL-001", "category": "PII.IDENTIFIER.DRIVERS_LICENSE", "type": "regex", "priority": 3,\\r\\n     "threshold": 0.85, "conf": 0.92,\\r\\n     "pattern": r"\\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b"},\\r\\n    {"classifier_id": "CLS-PII-ADDRESS-001", "category": "PII.LOCATION.STREET_ADDRESS", "type": "regex", "priority": 4,\\r\\n     "threshold": 0.85, "conf": 0.92,\\r\\n     "pattern": r"\\\\b\\\\d{1,5}\\\\s+[A-Za-z0-9\\\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\\\s.,#]+)?(?:,\\\\s+[A-Za-z\\\\s]+,\\\\s+[A-Z]{2}\\\\s+\\\\d{5}(?:-\\\\d{4})?)?\\\\b"},\\r\\n    {"classifier_id": "CLS-PHI-MED-ID-001", "category": "PHI.MEDICAL_IDENTIFIER", "type": "regex", "priority": 2,\\r\\n     "threshold": 0.90, "conf": 0.95, "pattern": r"\\\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\\\b"},\\r\\n    {"classifier_id": "CLS-PHI-CONDITION-001", "category": "PHI.HEALTH_DATA", "type": "dictionary_and_heuristic",\\r\\n     "priority": 3, "threshold": 0.85, "conf": 0.90,\\r\\n     "terms": ["penicillin allergy", "allergy", "Hypertension", "hypertension", "prescription adjustment",\\r\\n               "emergency dispensation", "medical dispensation"]},\\r\\n    {"classifier_id": "CLS-PII-NAME-001", "category": "PII.PERSON_NAME", "type": "ner", "entity_types": ["PERSON"],\\r\\n     "priority": 5, "threshold": 0.80, "conf": 0.95},\\r\\n]\\r\\n\\r\\ndef line_of(pos):\\r\\n    return DOC.count("\\\\n", 0, pos) + 1\\r\\n\\r\\ncandidates = []\\r\\nraw_counts = {}\\r\\n\\r\\n# --- Regex classifiers ---\\r\\nfor cl in CLS:\\r\\n    if cl["type"] != "regex":\\r\\n        continue\\r\\n    rx = re.compile(cl["pattern"])\\r\\n    ms = list(rx.finditer(DOC))\\r\\n    raw_counts[cl["classifier_id"]] = len(ms)\\r\\n    for m in ms:\\r\\n        candidates.append({"start": m.start(), "end": m.end(), "matched_text": m.group(0),\\r\\n                           "category": cl["category"], "classifier_id": cl["classifier_id"],\\r\\n                           "confidence": cl["conf"], "threshold": cl["threshold"],\\r\\n                           "priority": cl["priority"], "line": line_of(m.start())})\\r\\n\\r\\n# --- Dictionary classifier (case-sensitive per pinned term list) ---\\r\\ndict_cl = next(c for c in CLS if c["classifier_id"] == "CLS-PHI-CONDITION-001")\\r\\ndcount = 0\\r\\nfor t in dict_cl["terms"]:\\r\\n    idx = 0\\r\\n    while True:\\r\\n        i = DOC.find(t, idx)\\r\\n        if i == -1: break\\r\\n        candidates.append({"start": i, "end": i+len(t), "matched_text": t, "category": dict_cl["category"],\\r\\n                           "classifier_id": dict_cl["classifier_id"], "confidence": dict_cl["conf"],\\r\\n                           "threshold": dict_cl["threshold"], "priority": dict_cl["priority"], "line": line_of(i)})\\r\\n        dcount += 1\\r\\n        idx = i + len(t)\\r\\nraw_counts["CLS-PHI-CONDITION-001"] = dcount\\r\\n\\r\\n# --- NER classifier CLS-PII-NAME-001 (PERSON) ---\\r\\nner_method = "deterministic_labeled_field_extraction (no NER model runtime available in execution environment)"\\r\\nnm = re.search(r"^Full Name: (.+)$", DOC, re.M)\\r\\nif nm:\\r\\n    candidates.append({"start": nm.start(1), "end": nm.end(1), "matched_text": nm.group(1),\\r\\n                       "category": "PII.PERSON_NAME", "classifier_id": "CLS-PII-NAME-001",\\r\\n                       "confidence": 0.95, "threshold": 0.80, "priority": 5, "line": line_of(nm.start(1))})\\r\\n    raw_counts["CLS-PII-NAME-001"] = 1\\r\\nelse:\\r\\n    raw_counts["CLS-PII-NAME-001"] = 0\\r\\n\\r\\n# --- Contextual classification: DOB vs transaction timestamp ---\\r\\nBIRTH_CUES = ["date of birth", "dob", "born", "birth date", "d.o.b"]\\r\\nts_pos = DOC.find("Transaction Summary")\\r\\nemitted, suppressed = [], []\\r\\nfor c in candidates:\\r\\n    if c["classifier_id"] == "CLS-PII-DOB-001":\\r\\n        ln_start = DOC.rfind("\\\\n", 0, c["start"]) + 1\\r\\n        ln_end = DOC.find("\\\\n", c["end"]);  ln_end = len(DOC) if ln_end == -1 else ln_end\\r\\n        line_txt = DOC[ln_start:ln_end].lower()\\r\\n        ctx = DOC[max(0, c["start"]-200):c["end"]+50].lower()\\r\\n        has_birth_cue = any(k in line_txt or k in ctx for k in BIRTH_CUES)\\r\\n        in_txn_section = c["start"] > ts_pos\\r\\n        if (not has_birth_cue) and in_txn_section:\\r\\n            suppressed.append({k: c[k] for k in ("start","end","matched_text","classifier_id","line")})\\r\\n            suppressed[-1]["reason"] = "transaction_timestamp_context (Transaction Summary table row; no birth-context cues anywhere in document) - not DATE_OF_BIRTH"\\r\\n            continue\\r\\n    emitted.append(c)\\r\\n\\r\\n# --- Deterministic overlap/duplicate resolution ---\\r\\nemitted.sort(key=lambda c: (c["start"], -(c["end"]-c["start"]), c["priority"], -c["confidence"]))\\r\\nkept, dropped_overlap = [], 0\\r\\nfor c in emitted:\\r\\n    if all(c["end"] <= k["start"] or c["start"] >= k["end"] for k in kept):\\r\\n        kept.append(c)\\r\\n    else:\\r\\n        dropped_overlap += 1\\r\\n\\r\\n# --- Offset verification DOC[start:end] == matched_text ---\\r\\nverification_failures = []\\r\\nfor s in kept:\\r\\n    ok = DOC[s["start"]:s["end"]] == s["matched_text"]\\r\\n    s["offset_verification"] = "PASS" if ok else "FAIL"\\r\\n    if not ok: verification_failures.append(s)\\r\\nassert not verification_failures\\r\\n\\r\\nkept.sort(key=lambda s: s["start"])\\r\\n\\r\\n# --- Uncovered sensitive identifier check ---\\r\\ndef covered_by(token):\\r\\n    hits = []\\r\\n    for cl in CLS:\\r\\n        if cl["type"] == "regex":\\r\\n            if re.search(cl["pattern"], token): hits.append(cl["classifier_id"])\\r\\n        elif "terms" in cl:\\r\\n            if any(t.lower() in token.lower() for t in cl["terms"]): hits.append(cl["classifier_id"])\\r\\n    return hits\\r\\nuncovered = []\\r\\nfor label, tok in [("System Username","mavance_admin"), ("Health Insurance Number / member ID","HI-902849102-B")]:\\r\\n    st = DOC.find(tok)\\r\\n    uncovered.append({"start": st, "end": st+len(tok), "matched_text": tok, "label": label,\\r\\n                      "covered_by_enabled_classifiers": covered_by(tok), "line": line_of(st)})\\r\\n\\r\\n# --- Diagnostics: line-break splitting behavior ---\\r\\ncc = re.compile(next(c["pattern"] for c in CLS if c["classifier_id"]=="CLS-PII-CC-001"))\\r\\niban = re.compile(next(c["pattern"] for c in CLS if c["classifier_id"]=="CLS-PII-IBAN-001"))\\r\\ndiagnostics = {\\r\\n "visa_occurrences_4532_prefix": DOC.count("4532"),\\r\\n "visa_occurrences_8910-4321-9081": DOC.count("8910-4321-9081"),\\r\\n "cc_match_on_split_form_4532-NEWLINE-8910-4321-9081": bool(cc.search("4532-\\\\n8910-4321-9081")),\\r\\n "cc_match_if_hyphen_joined": bool(cc.search("4532-8910-4321-9081")),\\r\\n "cc_match_if_space_joined": bool(cc.search("4532- 8910-4321-9081")),\\r\\n "iban_occurrences_US39": DOC.count("US39"),\\r\\n "iban_occurrences_OBAK": DOC.count("OBAK"),\\r\\n "iban_match_on_split_form_US39-SPACE-NEWLINE-OBAK": bool(iban.search("US39 \\\\nOBAK")),\\r\\n "iban_match_on_full_form": bool(iban.search("US39 OBAK 0123 4567 8901 23")),\\r\\n "iban_matched_text_on_full_form": (iban.search("US39 OBAK 0123 4567 8901 23").group(0) if iban.search("US39 OBAK 0123 4567 8901 23") else None)\\r\\n}\\r\\n\\r\\nim = iban.search(DOC)\\r\\ndiagnostics["iban_span_in_doc"] = {"start": im.start(), "end": im.end(), "matched_text": im.group(0)} if im else None\\r\\n\\r\\ncounts = {}\\r\\nfor s in kept:\\r\\n    counts[s["category"]] = counts.get(s["category"], 0) + 1\\r\\n\\r\\nresult = {\\r\\n "document": {"name": "test_file.pdf", "declared_length": 784, "measured_length": doc_len, "length_matches_declaration": doc_len == 784},\\r\\n "ruleset": {"revision_id": "rev-001", "status": "PINNED", "read_only": True, "mutation_performed": False, "classifiers_applied": 13},\\r\\n "spans": kept,\\r\\n "suppressed_candidates": suppressed,\\r\\n "uncovered_sensitive_identifiers": uncovered,\\r\\n "diagnostics_line_break_behavior": diagnostics,\\r\\n "metadata": {\\r\\n   "total_detections_emitted": len(kept),\\r\\n   "counts_per_category": counts,\\r\\n   "raw_candidates_before_context_filter": len(candidates),\\r\\n   "candidates_suppressed_by_context": len(suppressed),\\r\\n   "overlaps_dropped_in_resolution": dropped_overlap,\\r\\n   "raw_matches_per_classifier": raw_counts,\\r\\n   "zero_match_classifiers": [c["classifier_id"] for c in CLS if raw_counts.get(c["classifier_id"], 0) == 0],\\r\\n   "ner_method_note": ner_method,\\r\\n   "confidence_note": "Ruleset rev-001 pins per-classifier confidence_threshold only; per-span confidence values are deterministic detector match confidences, all >= pinned thresholds."\\r\\n }\\r\\n}\\r\\n\\r\\njson_result = json.dumps(result, indent=2)\\r\\njson_result\'}, \'extras\': {\'container_id\': \'cntr_6ad5ff31039c819188509e5ead54facf0d0ef51446e54eb9\'}}, {\'type\': \'server_tool_result\', \'tool_call_id\': \'ci_0d369356a8058854006ad5ff31db4887d296181f65b3d172f5\', \'status\': \'success\'}, {\'type\': \'text\', \'text\': \'Here\\\'s the JSON result:\\n\\n```json\\n{\\n  "document": {\\n    "name": "test_file.pdf",\\n    "declared_length": 784,\\n    "measured_length": 784,\\n    "length_matches_declaration": true\\n  },\\n  "ruleset": {\\n    "revision_id": "rev-001",\\n    "status": "PINNED",\\n    "read_only": true,\\n    "mutation_performed": false,\\n    "classifiers_applied": 13\\n  },\\n  "spans": [\\n    {\\n      "start": 44,\\n      "end": 65,\\n      "matched_text": "Marcus Aurelius Vance",\\n      "category": "PII.PERSON_NAME",\\n      "classifier_id": "CLS-PII-NAME-001",\\n      "confidence": 0.95,\\n      "threshold": 0.8,\\n      "priority": 5,\\n      "line": 2,\\n      "offset_verification": "PASS"\\n    },\\n    {\\n      "start": 112,\\n      "end": 142,\\n      "matched_text": "m.vance@vanceresearch-labs.org",\\n      "category": "PII.CONTACT.EMAIL",\\n      "classifier_id