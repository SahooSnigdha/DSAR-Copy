gex\\": r\\"\\\\b[A-Z]\\\\d{8,9}\\\\b\\", \\"confidence\\": 0.88\\n    },\\n    \\"CLS-PII-DL-001\\": {\\n        \\"category\\": \\"PII.IDENTIFIER.DRIVERS_LICENSE\\", \\"priority\\": 3, \\"threshold\\": 0.85,\\n        \\"regex\\": r\\"\\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b\\", \\"confidence\\": 0.88\\n    },\\n    \\"CLS-PII-ADDRESS-001\\": {\\n        \\"category\\": \\"PII.LOCATION.STREET_ADDRESS\\", \\"priority\\": 4, \\"threshold\\": 0.85,\\n        \\"regex\\": r\\"\\\\b\\\\d{1,5}[ \\\\t]+[A-Za-z0-9., \\\\t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \\\\t]+(?:Suite|Ste|Apt|Unit|#)[ \\\\t]+[A-Za-z0-9-]+)?,[ \\\\t]+[A-Za-z \\\\t]+,[ \\\\t]+[A-Z]{2}[ \\\\t]+\\\\d{5}(?:-\\\\d{4})?\\\\b|\\\\b\\\\d{1,5}[ \\\\t]+[A-Za-z0-9., \\\\t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \\\\t]+(?:Suite|Ste|Apt|Unit|#)[ \\\\t]+[A-Za-z0-9-]+)?\\\\b\\", \\"confidence\\": 0.89\\n    },\\n    \\"CLS-PHI-MED-ID-001\\": {\\n        \\"category\\": \\"PHI.MEDICAL_IDENTIFIER\\", \\"priority\\": 2, \\"threshold\\": 0.90,\\n        \\"regex\\": r\\"\\\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\\\b\\", \\"confidence\\": 0.92\\n    },\\n    \\"CLS-PHI-CONDITION-001\\": {\\n        \\"category\\": \\"PHI.HEALTH_DATA\\", \\"priority\\": 3, \\"threshold\\": 0.85,\\n        \\"terms\\": [\\"penicillin allergy\\", \\"allergy\\", \\"Hypertension\\", \\"hypertension\\", \\"prescription adjustment\\", \\"emergency dispensation\\", \\"medical dispensation\\"],\\n        \\"confidence\\": 0.87\\n    }\\n}\\n\\ncandidates = []\\n\\ndef add_span(start, end, text_, category, classifier_id, confidence, priority):\\n    if end <= start:\\n        return\\n    if confidence < 0.0:\\n        return\\n    candidates.append({\\n        \\"start\\": start,\\n        \\"end\\": end,\\n        \\"text\\": text_,\\n        \\"category\\": category,\\n        \\"classifier_id\\": classifier_id,\\n        \\"confidence\\": round(float(confidence), 2),\\n        \\"priority\\": priority\\n    })\\n\\n# Standard regex classifiers\\nfor cid, spec in patterns.items():\\n    if \\"regex\\" not in spec:\\n        continue\\n    for m in re.finditer(spec[\\"regex\\"], text):\\n        # Contextual DOB gate: transaction/log dates are not DOB\\n        if cid == \\"CLS-PII-DOB-001\\":\\n            pre = text[max(0, m.start()-40):m.start()].lower()\\n            post = text[m.end():m.end()+40].lower()\\n            context = pre + \\" \\" + post\\n            if (\\"transaction\\" in context or \\"login\\" in context or \\"log\\" in context or \\"date type\\" in context):\\n                continue\\n        conf = spec[\\"confidence\\"]\\n        # Credit card: soft-fail Luhn. Compute on digits only.\\n        if cid == \\"CLS-PII-CC-001\\":\\n            digits = re.sub(r\\"\\\\D\\", \\"\\", m.group(0))\\n            def luhn_ok(s):\\n                total = 0\\n                rev = s[::-1]\\n                for i, ch in enumerate(rev):\\n                    d = int(ch)\\n                    if i % 2 == 1:\\n                        d *= 2\\n                        if d > 9:\\n                            d -= 9\\n                    total += d\\n                return total % 10 == 0\\n            conf = 0.99 if luhn_ok(digits) else 0.86\\n        if conf >= spec[\\"threshold\\"]:\\n            add_span(m.start(), m.end(), m.group(0), spec[\\"category\\"], cid, conf, spec[\\"priority\\"])\\n\\n# Username (regex_context, capture group 1)\\nusername_re = re.compile(r\\"(?i:\\\\b(?:Account Name|Username|User Name|Login|Account):[ \\\\t]*)(?!Role\\\\b)([a-zA-Z][a-zA-Z0-9._-]{2,30})\\\\b\\")\\nfor m in username_re.finditer(text):\\n    add_span(m.start(1), m.end(1), m.group(1), \\"PII.IDENTIFIER.USERNAME\\", \\"CLS-PII-USERNAME-001\\", 0.86, 3)\\n\\n# Health insurance member ID (regex capture alternative + bare prefixed alternative)\\nins_re = re.compile(r\\"\\\\b(?:HI|INS|POL|GRP)-[A-Za-z0-9-]{6,16}\\\\b|(?i:\\\\bHealth Insurance (?:Number|ID|Member ID):[ \\\\t]*)([A-Za-z0-9-]+)\\\\b\\")\\nfor m in ins_re.finditer(text):\\n    if m.group(1):\\n        add_span(m.start(1), m.end(1), m.group(1), \\"PHI.MEDICAL_IDENTIFIER.HEALTH_INSURANCE_MEMBER_ID\\", \\"CLS-PHI-INSURANCE-MEMBER-ID-001\\", 0.90, 2)\\n    else:\\n        add_span(m.start(), m.end(), m.group(0), \\"PHI.MEDICAL_IDENTIFIER.HEALTH_INSURANCE_MEMBER_ID\\", \\"CLS-PHI-INSURANCE-MEMBER-ID-001\\", 0.90, 2)\\n\\n# NER simulation: deterministic PERSON extraction anchored by explicit Full Name label.\\n# This is the only person entity present; confidence set at the NER threshold.\\nfor m in re.finditer(r\\"(?i:\\\\bFull Name:[ \\\\t]*)([A-Z][A-Za-z.\'-]+(?:[ \\\\t]+[A-Z][A-Za-z.\'-]+){1,4})\\\\b\\", text):\\n    add_span(m.start(1), m.end(1), m.group(1), \\"PII.PERSON_NAME\\", \\"CLS-PII-NAME-001\\", 0.80, 5)\\n\\n# Dictionary/heuristic health terms\\nfor term in patterns[\\"CLS-PHI-CONDITION-001\\"][\\"terms\\"]:\\n    for m in re.finditer(r\\"\\\\b\\" + re.escape(term) + r\\"\\\\b\\", text, flags=re.IGNORECASE):\\n        add_span(m.start(), m.end(), m.group(0), \\"PHI.HEALTH_DATA\\", \\"CLS-PHI-CONDITION-001\\", 0.87, 3)\\n\\n# Resolve overlaps deterministically:\\n# start offset ascending, match length descending, priority ascending, confidence descending\\ncandidates.sort(key=lambda x: (x[\\"start\\"], -(x[\\"end\\"] - x[\\"start\\"]), x[\\"priority\\"], -x[\\"confidence\\"], x[\\"classifier_id\\"]))\\nkept = []\\nfor c in candidates:\\n    if not any(not (c[\\"end\\"] <= k[\\"start\\"] or c[\\"start\\"] >= k[\\"end\\"]) for k in kept):\\n        kept.append(c)\\nkept.sort(key=lambda x: (x[\\"start\\"], x[\\"end\\"], x[\\"classifier_id\\"]))\\n\\n# metadata\\ntotal = len(kept)\\ncounts = {}\\nfor k in kept:\\n    counts[k[\\"category\\"]] = counts.get(k[\\"category\\"], 0) + 1\\n\\nprint(json.dumps({\\n    \\"ruleset\\": {\\"revision_id\\": \\"rev-002\\", \\"ruleset_version\\": \\"1.1.0\\", \\"status\\": \\"PINNED\\", \\"integrity_hash\\": \\"sha256-rev2-master-data-classifiers-pinned\\"},\\n    \\"document_length\\": len(text),\\n    \\"total_detections\\": total,\\n    \\"counts_per_category\\": counts,\\n    \\"spans\\": kept\\n}, indent=2, ensure_ascii=False))\\n\\n# Also print full document with offset ruler for verification\\nprint(\\"\\\\nDOCUMENT:\\\\n\\")\\nprint(text)\\nprint(\\"\\\\nOFFSET CHECK:\\")\\nfor k in kept:\\n    print(f\\"{k[\'start\']:4d}-{k[\'end\']:4d} | {k[\'classifier_id\']:35s} | {k[\'text\']!r}\\")\\n"}}'}
