01","category":"PII.FINANCIAL.BANK_ACCOUNT","type":"regex","priority":2,"threshold":0.90,"conf":0.96, "pattern":r"\b[A-Z]{2}\d{2}(?:\s?[A-Z0-9]{4}){3,7}\b"}, {"classifier_id":"CLS-PII-PASSPORT-001","category":"PII.IDENTIFIER.PASSPORT","type":"regex","priority":3,"threshold":0.85,"conf":0.95, "pattern":r"\b[A-Z]\d{8,9}\b"}, {"classifier_id":"CLS-PII-DL-001","category":"PII.IDENTIFIER.DRIVERS_LICENSE","type":"regex","priority":3,"threshold":0.85,"conf":0.92, "pattern":r"\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\b"}, {"classifier_id":"CLS-PII-ADDRESS-001","category":"PII.LOCATION.STREET_ADDRESS","type":"regex","priority":4,"threshold":0.85,"conf":0.92, "pattern":r"\b\d{1,5}\s+[A-Za-z0-9\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\s.,#]+)?(?:,\s+[A-Za-z\s]+,\s+[A-Z]{2}\s+\d{5}(?:-\d{4})?)?\b"}, {"classifier_id":"CLS-PHI-MED-ID-001","category":"PHI.MEDICAL_IDENTIFIER","type":"regex","priority":2,"threshold":0.90,"conf":0.95, "pattern":r"\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\b"}, {"classifier_id":"CLS-PHI-CONDITION-001","category":"PHI.HEALTH_DATA","type":"dictionary_and_heuristic","priority":3,"threshold":0.85,"conf":0.90, "terms":["penicillin allergy","allergy","Hypertension","hypertension","prescription adjustment","emergency dispensation","medical dispensation"]}, ] def line_of(pos): return DOC.count("\n", 0, pos) + 1 candidates = [] # --- Regex classifiers --- for cl in CLS: if cl["type"] != "regex": continue rx = re.compile(cl["pattern"]) ms = list(rx.finditer(DOC)) raw_counts[cl["classifier_id"]] = len(ms) for m in ms: candidates.append({"start": m.start(), "end": m.end(), "matched_text": m.group(0), "category": cl["category"], "classifier_id": cl["classifier_id"], "confidence": cl["conf"], "threshold": cl["threshold"], "priority": cl["priority"], "line": line_of(m.start())}) # --- Dictionary classifier (case-sensitive per pinned term list) --- dict_cl = next(c for c in CLS if c["classifier_id"] == "CLS-PHI-CONDITION-001") dcount = 0 for t in dict_cl["terms"]: idx = 0 while True: i = DOC.find(t, idx) if i == -1: break candidates.append({"start": i, "end": i+len(t), "matched_text": t, "category": dict_cl["category"], "classifier_id": dict_cl["classifier_id"], "confidence": dict_cl["conf"], "threshold": dict_cl["threshold"], "priority": dict_cl["priority"], "line": line_of(i)}) dcount += 1 idx = i + len(t) raw_counts["CLS-PHI-CONDITION-001"] = dcount # --- NER classifier CLS-PII-NAME-001 (PERSON) --- ner_method = "deterministic_labeled_field_extraction (no NER model runtime available in execution environment)" nm = re.search(r"^Full Name: (.+)$", DOC, re.M) if nm: candidates.append({"start": nm.start(1), "end": nm.end(1), "matched_text": nm.group(1), "category": "PII.PERSON_NAME", "classifier_id": "CLS-PII-NAME-001", "confidence": 0.95, "threshold": 0.80, "priority": 5, "line": line_of(nm.start(1))}) raw_counts["CLS-PII-NAME-001"] = 1 else: raw_counts["CLS-PII-NAME-001"] = 0 # --- Contextual classification: DOB vs transaction timestamp --- BIRTH_CUES = ["date of birth", "dob", "born", "birth date", "d.o.b"] ts_pos = DOC.find("Transaction Summary") emitted, suppressed = [], [] for c in candidates: if c["classifier_id"] == "CLS-PII-DOB-001": ln_start = DOC.rfind("\n", 0, c["start"]) + 1 ln_end = DOC.find("\n", c["end"]);  ln_end = len(DOC) if ln_end == -1 else ln_end line_txt = DOC[ln_start:ln_end].lower() ctx = DOC[max(0, c["start"]-200):c["end"]+50].lower() has_birth_cue = any(k in line_txt or k in ctx for k in BIRTH_CUES) in_txn_section = c["start"] > ts_pos if (not has_birth_cue) and in_txn_section: suppressed.append({k: c[k] for k in ("start","end","matched_text","classifier_id","line")}) suppressed[-1]["reason"] = "transaction_timestamp_context (Transaction Summary table row; no birth-context cues anywhere in document) - not DATE_OF_BIRTH" continue emitted.append(c) # --- Deterministic overlap/duplicate resolution --- # order: start asc, match length desc, priority asc, confidence desc; keep highest-priority non-overlapping emitted.sort(key=lambda c: (c["start"], -(c["end"]-c["start"]), c["priority"], -c["confidence"])) kept, dropped_overlap = [], 0 for c in emitted: if all(c["end"] <= k["start"] or c["start"] >= k["end"] for k in kept): kept.append(c) else: dropped_overlap += 1 # --- Offset verification DOC[start:end] == matched_text --- verification_failures = [] for s in kept: ok = DOC[s["start"]:s["end"]] == s["matched_text"] s["offset_verification"] = "PASS" if ok else "FAIL" if not ok: verification_failures.append(s) assert not verification_failures kept.sort(key=lambda s: s["start"]) # --- Uncovered sensitive identifier check --- def covered_by(token): hits = [] for cl in CLS: if cl["type"] == "regex": if re.search(cl["pattern"], token): hits.append(cl["classifier_id"]) elif "terms" in cl: if any(t.lower() in token.lower() for t in cl["terms"]): hits.append(cl["classifier_id"]) return hits uncovered = [] for label, tok in [("System Username","mavance_admin"), ("Health Insurance Number / member ID","HI-902849102-B")]: st = DOC.find(tok) uncovered.append({"start": st, "end": st+len(tok), "matched_text": tok, "label": label, "covered_by_enabled_classifiers": covered_by(tok), "line": line_of(st)}) # --- Diagnostics: line-break splitting behavior --- cc = re.compile(next(c["pattern"] for c in CLS if c["classifier_id"]=="CLS-PII-CC-001")) iban = re.compile(next(c["pattern"] for c in CLS if c["classifier_id"]=="CLS-PII-IBAN-001")) diagnostics = { "visa_occurrences_4532_prefix": DOC.count("4532"), "visa_occurrences_8910-4321-9081": DOC.count("8910-4321-9081"), "cc_match_on_split_form_4532-NEWLINE-8910-4321-9081": bool(cc.search("4532-\n8910-4321-9081")), "cc_match_if_hyphen_joined": bool(cc.search("4532-8910-4321-9081")), "cc_match_if_space_joined": bool(cc.search("4532- 8910-4321-9081")), "iban_occurrences_US39": DOC.count("US39"), "iban_occurrences_OBAK": DOC.count("OBAK"), "iban_match_on_split_form_US39-SPACE-NEWLINE-OBAK": bool(iban.search("US39 \nOBAK")), "iban_match_on_full_form": bool(iban.search("US39 OBAK 0123 4567 8901 23")), "iban_matched_text_on_full_form": (iban.search("US39 OBAK 0123 4567 8901 23").group(0) if iban.search("US39 OBAK 0123 4567 8901 23") else None) } # IBAN span inside DOC im = iban.search(DOC) diagnostics["iban_span_in_doc"] = {"start": im.start(), "end": im.end(), "matched_text": im.group(0)} if im else None for s in kept: counts[s["category"]] = counts.get(s["category"], 0) + 1 result = { "document": {"name": "test_file.pdf", "declared_length": 784, "measured_length": doc_len, "length_matches_declaration": doc_len == 784}, "ruleset": {"revision_id": "rev-001", "status": "PINNED", "read_only": True, "mutation_performed": False, "classifiers_applied": 13}, "spans": kept, "suppressed_candidates": suppressed, "uncovered_sensitive_identifiers": uncovered, "diagnostics_line_break_behavior": diagnostics, "metadata": { "total_detections_emitted": len(kept), "counts_per_category": counts, "raw_candidates_before_context_filter": len(candidates), "candidates_suppressed_by_context": len(suppressed), "overlaps_dropped_in_resolution": dropped_overlap, "raw_matches_per_classifier": raw_counts, "zero_match_classifiers": [c["classifier_id"] for c in CLS if raw_counts.get(c["classifier_id"], 0) == 0], "ner_method_note": ner_method, "confidence_note": "Ruleset rev-001 pins per-classifier confidence_threshold only; per-span confidence values are deterministic detector match confidences, all >= pinned thresholds." } } print(json.dumps(result, indent=2))", "user_id": "snigdhasahoo", "Timestamp": "2026-10-19T12:29:52.651705", "source": "HttpServer", "message_type": "Other", "request_id": "request-10"}
