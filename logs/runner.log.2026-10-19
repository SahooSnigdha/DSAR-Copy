ertension", "hypertension", "prescription adjustment", "emergency dispensation", "medical dispensation"], "confidence": 0.87 } } candidates = [] def add_span(start, end, text_, category, classifier_id, confidence, priority): if end <= start: return if confidence < 0.0: return candidates.append({ "start": start, "end": end, "text": text_, "category": category, "classifier_id": classifier_id, "confidence": round(float(confidence), 2), "priority": priority }) # Standard regex classifiers for cid, spec in patterns.items(): if "regex" not in spec: continue for m in re.finditer(spec["regex"], text): # Contextual DOB gate: transaction/log dates are not DOB if cid == "CLS-PII-DOB-001": pre = text[max(0, m.start()-40):m.start()].lower() post = text[m.end():m.end()+40].lower() context = pre + " " + post if ("transaction" in context or "login" in context or "log" in context or "date type" in context): continue conf = spec["confidence"] # Credit card: soft-fail Luhn. Compute on digits only. if cid == "CLS-PII-CC-001": digits = re.sub(r"\D", "", m.group(0)) def luhn_ok(s): total = 0 rev = s[::-1] for i, ch in enumerate(rev): d = int(ch) if i % 2 == 1: d *= 2 if d > 9: d -= 9 total += d return total % 10 == 0 conf = 0.99 if luhn_ok(digits) else 0.86 if conf >= spec["threshold"]: add_span(m.start(), m.end(), m.group(0), spec["category"], cid, conf, spec["priority"]) # Username (regex_context, capture group 1) username_re = re.compile(r"(?i:\b(?:Account Name|Username|User Name|Login|Account):[ \t]*)(?!Role\b)([a-zA-Z][a-zA-Z0-9._-]{2,30})\b") for m in username_re.finditer(text): add_span(m.start(1), m.end(1), m.group(1), "PII.IDENTIFIER.USERNAME", "CLS-PII-USERNAME-001", 0.86, 3) # Health insurance member ID (regex capture alternative + bare prefixed alternative) ins_re = re.compile(r"\b(?:HI|INS|POL|GRP)-[A-Za-z0-9-]{6,16}\b|(?i:\bHealth Insurance (?:Number|ID|Member ID):[ \t]*)([A-Za-z0-9-]+)\b") for m in ins_re.finditer(text): if m.group(1): add_span(m.start(1), m.end(1), m.group(1), "PHI.MEDICAL_IDENTIFIER.HEALTH_INSURANCE_MEMBER_ID", "CLS-PHI-INSURANCE-MEMBER-ID-001", 0.90, 2) else: add_span(m.start(), m.end(), m.group(0), "PHI.MEDICAL_IDENTIFIER.HEALTH_INSURANCE_MEMBER_ID", "CLS-PHI-INSURANCE-MEMBER-ID-001", 0.90, 2) # NER simulation: deterministic PERSON extraction anchored by explicit Full Name label. # This is the only person entity present; confidence set at the NER threshold. for m in re.finditer(r"(?i:\bFull Name:[ \t]*)([A-Z][A-Za-z.'-]+(?:[ \t]+[A-Z][A-Za-z.'-]+){1,4})\b", text): add_span(m.start(1), m.end(1), m.group(1), "PII.PERSON_NAME", "CLS-PII-NAME-001", 0.80, 5) # Dictionary/heuristic health terms for term in patterns["CLS-PHI-CONDITION-001"]["terms"]: for m in re.finditer(r"\b" + re.escape(term) + r"\b", text, flags=re.IGNORECASE): add_span(m.start(), m.end(), m.group(0), "PHI.HEALTH_DATA", "CLS-PHI-CONDITION-001", 0.87, 3) # Resolve overlaps deterministically: # start offset ascending, match length descending, priority ascending, confidence descending candidates.sort(key=lambda x: (x["start"], -(x["end"] - x["start"]), x["priority"], -x["confidence"], x["classifier_id"])) kept = [] for c in candidates: if not any(not (c["end"] <= k["start"] or c["start"] >= k["end"]) for k in kept): kept.append(c) kept.sort(key=lambda x: (x["start"], x["end"], x["classifier_id"])) # metadata total = len(kept) for k in kept: counts[k["category"]] = counts.get(k["category"], 0) + 1 print(json.dumps({ "document_length": len(text), "total_detections": total, "counts_per_category": counts, "spans": kept }, indent=2, ensure_ascii=False)) # Also print full document with offset ruler for verification print("\nDOCUMENT:\n") print(text) print("\nOFFSET CHECK:") for k in kept: print(f"{k['start']:4d}-{k['end']:4d} | {k['classifier_id']:35s} | {k['text']!r}") ", "user_id": "snigdhasahoo", "Timestamp": "2026-10-19T13:22:55.726969", "source": "HttpServer", "message_type": "Other", "request_id": "request-5"}
