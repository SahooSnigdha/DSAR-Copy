-PII-IP-001", "name": "IP Address (IPv4 & IPv6)", "category": "PII.LOCATION.IP_ADDRESS", "type": "regex", "pattern": "\\\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\b|\\\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\\\b", "confidence_threshold": 0.90, "priority": 3, "mask_token": "[IP_ADDRESS]", "description": "IPv4 dotted-decimal and IPv6 8-group addresses." },\n        { "classifier_id": "CLS-PII-DOB-001", "name": "Date of Birth", "category": "PII.DEMOGRAPHIC.DATE_OF_BIRTH", "type": "regex", "pattern": "\\\\b(?:19|20)\\\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])\\\\b|\\\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\\\s+(?:0?[1-9]|[12]\\\\d|3[01]),\\\\s+(?:19|20)\\\\d{2}\\\\b", "confidence_threshold": 0.85, "priority": 3, "mask_token": "[DATE_OF_BIRTH]", "description": "ISO-8601 dates and month-name formatted dates of birth." },\n        { "classifier_id": "CLS-PII-IBAN-001", "name": "Bank Account (IBAN)", "category": "PII.FINANCIAL.BANK_ACCOUNT", "type": "regex", "pattern": "\\\\b[A-Z]{2}\\\\d{2}(?:\\\\s?[A-Z0-9]{4}){3,7}\\\\b", "confidence_threshold": 0.90, "priority": 2, "mask_token": "[BANK_ACCOUNT]", "description": "International Bank Account Numbers with optional spacing." },\n        { "classifier_id": "CLS-PII-PASSPORT-001", "name": "Passport Number", "category": "PII.IDENTIFIER.PASSPORT", "type": "regex", "pattern": "\\\\b[A-Z]\\\\d{8,9}\\\\b", "confidence_threshold": 0.85, "priority": 3, "mask_token": "[PASSPORT]", "description": "Standard alphanumeric passport identifiers." },\n        { "classifier_id": "CLS-PII-DL-001", "name": "Driver\'s License", "category": "PII.IDENTIFIER.DRIVERS_LICENSE", "type": "regex", "pattern": "\\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b", "confidence_threshold": 0.85, "priority": 3, "mask_token": "[DRIVERS_LICENSE]", "description": "Standard state driver\'s license numbers with DL- prefix." },\n        { "classifier_id": "CLS-PII-ADDRESS-001", "name": "Residential / Work Street Address", "category": "PII.LOCATION.STREET_ADDRESS", "type": "regex", "pattern": "\\\\b\\\\d{1,5}\\\\s+[A-Za-z0-9\\\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\\\s.,#]+)?(?:,\\\\s+[A-Za-z\\\\s]+,\\\\s+[A-Z]{2}\\\\s+\\\\d{5}(?:-\\\\d{4})?)?\\\\b", "confidence_threshold": 0.85, "priority": 4, "mask_token": "[STREET_ADDRESS]", "description": "Physical postal street address including street name, city, state, zip." },\n        { "classifier_id": "CLS-PII-NAME-001", "name": "Full Name / Individual Name", "category": "PII.PERSON_NAME", "type": "ner", "entity_types": ["PERSON"], "confidence_threshold": 0.80, "priority": 5, "mask_token": "[NAME]", "description": "Named entity person recognizer for personal and professional names." },\n        { "classifier_id": "CLS-PHI-MED-ID-001", "name": "Medical Case Ref / Patient Member ID", "category": "PHI.MEDICAL_IDENTIFIER", "type": "regex", "pattern": "\\\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\\\b", "confidence_threshold": 0.90, "priority": 2, "mask_token": "[MEDICAL_ID]", "description": "Identifiers for medical case references, patient IDs, member IDs." },\n        { "classifier_id": "CLS-PHI-CONDITION-001", "name": "Health Condition / Prescription / Allergy", "category": "PHI.HEALTH_DATA", "type": "dictionary_and_heuristic", "terms": ["penicillin allergy", "allergy", "Hypertension", "hypertension", "prescription adjustment", "emergency dispensation", "medical dispensation"], "confidence_threshold": 0.85, "priority": 3, "mask_token": "[HEALTH_DATA]", "description": "Clinical health condition diagnoses, allergies, and prescription notations." }\n      ],\n      "history": [\n        {\n          "revision_id": "rev-001",\n          "ruleset_version": "1.0.0",\n          "actor": "Human Admin",\n          "actor_id": "ADMIN-ROOT-001",\n          "timestamp": "2026-10-16T13:30:00Z",\n          "approval_token": "AUTH-TOK