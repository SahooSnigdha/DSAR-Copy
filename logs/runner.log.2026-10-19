r Data Classifiers Ruleset",\n    "revision": 1,\n    "revision_id": "rev-001",\n    "ruleset_version": "1.0.0",\n    "created_at": "2026-10-16T13:30:00Z",\n    "created_by": "Human Admin",\n    "approval_actor": "ADMIN-ROOT-001",\n    "approval_token": "AUTH-TOKEN-ADMIN-REV1-APPROVED-20261016-ROOT",\n    "approval_timestamp": "2026-10-16T13:30:00Z",\n    "integrity_hash": "sha256-rev1-master-data-classifiers-pinned",\n    "description": "Initial provisioned, immutable pinned Master Data Classifiers revision covering PII and PHI entities with category definitions, regex patterns, NER entity models, and confidence thresholds."\n  },\n  "categories": {\n    "PII": {\n      "description": "Personally Identifiable Information",\n      "subcategories": {\n        "PERSON_NAME": { "description": "Full or partial names of individuals" },\n        "IDENTIFIER": {\n          "description": "Government or official identity numbers",\n          "types": ["SSN", "NATIONAL_ID", "PASSPORT", "DRIVERS_LICENSE"]\n        },\n        "CONTACT": {\n          "description": "Direct communication contact information",\n          "types": ["EMAIL", "PHONE_NUMBER"]\n        },\n        "LOCATION": {\n          "description": "Physical addresses and network locations",\n          "types": ["STREET_ADDRESS", "IP_ADDRESS"]\n        },\n        "FINANCIAL": {\n          "description": "Banking, payment, and transaction identifiers",\n          "types": ["CREDIT_CARD", "BANK_ACCOUNT", "IBAN", "CVV"]\n        },\n        "DEMOGRAPHIC": {\n          "description": "Personal demographic attributes",\n          "types": ["DATE_OF_BIRTH"]\n        }\n      }\n    },\n    "PHI": {\n      "description": "Protected Health Information",\n      "subcategories": {\n        "MEDICAL_IDENTIFIER": {\n          "description": "Patient, member, or clinical record identifiers",\n          "types": ["PATIENT_ID", "MEDICAL_CASE_REF"]\n        },\n        "HEALTH_DATA": {\n          "description": "Medical conditions, diagnoses, allergies, and prescriptions",\n          "types": ["ALLERGY", "CONDITION", "PRESCRIPTION", "CLINICAL_NOTE"]\n        }\n      }\n    }\n  },\n  "classifiers": [\n    {\n      "classifier_id": "CLS-PII-SSN-001",\n      "name": "Social Security Number / National ID",\n      "category": "PII.IDENTIFIER.SSN",\n      "type": "regex",\n      "pattern": "\\\\b\\\\d{3}-\\\\d{2}-\\\\d{4}\\\\b",\n      "confidence_threshold": 0.95,\n      "priority": 1,\n      "mask_token": "[SSN]",\n      "description": "Standard 9-digit US Social Security Number in AAA-GG-SSSS format."\n    },\n    {\n      "classifier_id": "CLS-PII-CC-001",\n      "name": "Credit Card Number",\n      "category": "PII.FINANCIAL.CREDIT_CARD",\n      "type": "regex",\n      "pattern": "\\\\b(?:4\\\\d{3}|5[1-5]\\\\d{2}|6011|3[47]\\\\d{2})[- ]?\\\\d{4}[- ]?\\\\d{4}[- ]?\\\\d{4}\\\\b|\\\\b\\\\d{4}-\\\\d{4}-\\\\d{4}-\\\\d{4}\\\\b",\n      "confidence_threshold": 0.95,\n      "priority": 1,\n      "mask_token": "[CREDIT_CARD]",\n      "description": "Major credit card numbers (Visa, Mastercard, Amex, Discover)."\n    },\n    {\n      "classifier_id": "CLS-PII-EMAIL-001",\n      "name": "Email Address",\n      "category": "PII.CONTACT.EMAIL",\n      "type": "regex",\n      "pattern": "\\\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}\\\\b",\n      "confidence_threshold": 0.95,\n      "priority": 2,\n      "mask_token": "[EMAIL]",\n      "description": "Standard RFC-compliant email address format."\n    },\n    {\n      "classifier_id": "CLS-PII-PHONE-001",\n      "name": "Telephone Number",\n      "category": "PII.CONTACT.PHONE_NUMBER",\n      "type": "regex",\n      "pattern": "(?:\\\\+?1[-. ]?)?(?:\\\\(\\\\d{3}\\\\)|\\\\b\\\\d{3})[-. ]?\\\\d{3}[-. ]?\\\\d{4}\\\\b",\n      "confidence_threshold": 0.90,\n      "priority": 2,\n      "mask_token": "[PHONE_NUMBER]",\n      "description": "North American phone numbers with optional country code, parentheses, dashes, or dots."\n    },\n    {\n    