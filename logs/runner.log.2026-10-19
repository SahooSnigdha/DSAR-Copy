\n)?\\\\d{4})-(?:\\\\n|\\\\r\\\\n)?\\\\d{4})|(?:\\\\s\\\\d{4}\\\\s\\\\d{4}\\\\s\\\\d{4})))\\\\b | validator: luhn_soft_fail (luhn_pass_confidence 0.99, luhn_fail_confidence 0.86, threshold 0.85) | mask_token: [CREDIT_CARD] | mask_strategy: partial (PCI DSS, keep last 4)\\n\\n3) classifier_id: CLS-PII-EMAIL-001 | name: Email Address | category: PII.CONTACT.EMAIL | type: regex | priority: 2 | confidence_threshold: 0.95 | pattern: \\\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}\\\\b | mask_token: [EMAIL] | mask_strategy: partial (mask local part, keep @domain)\\n\\n4) classifier_id: CLS-PII-PHONE-001 | name: Telephone Number | category: PII.CONTACT.PHONE_NUMBER | type: regex | priority: 2 | confidence_threshold: 0.9 | pattern: (?:\\\\+?1[-. ]?)?(?:\\\\(\\\\d{3}\\\\)|\\\\b\\\\d{3})[-. ]?\\\\d{3}[-. ]?\\\\d{4}\\\\b | mask_token: [PHONE_NUMBER] | mask_strategy: partial (keep country code/punctuation)\\n\\n5) classifier_id: CLS-PII-IP-001 | name: IP Address (IPv4 & IPv6) | category: PII.LOCATION.IP_ADDRESS | type: regex | priority: 3 | confidence_threshold: 0.9 | pattern: \\\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\b|\\\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\\\b | mask_token: [IP_ADDRESS] | mask_strategy: full\\n\\n6) classifier_id: CLS-PII-DOB-001 | name: Date of Birth | category: PII.DEMOGRAPHIC.DATE_OF_BIRTH | type: regex | priority: 3 | confidence_threshold: 0.85 | pattern: \\\\b(?:19|20)\\\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])\\\\b|\\\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\\\s+(?:0?[1-9]|[12]\\\\d|3[01]),\\\\s+(?:19|20)\\\\d{2}\\\\b | mask_token: [DATE_OF_BIRTH] | mask_strategy: full\\n\\n7) classifier_id: CLS-PII-IBAN-001 | name: Bank Account (IBAN) | category: PII.FINANCIAL.IBAN | type: regex | priority: 2 | confidence_threshold: 0.9 | pattern: \\\\b[A-Z]{2}\\\\d{2}(?:\\\\s?[A-Z0-9]{4}){3,7}(?:\\\\s?[A-Z0-9]{1,4})?\\\\b | mask_token: [IBAN] | mask_strategy: partial (keep country code + check digits and last 2-4 chars)\\n\\n8) classifier_id: CLS-PII-PASSPORT-001 | name: Passport Number | category: PII.IDENTIFIER.PASSPORT | type: regex | priority: 3 | confidence_threshold: 0.85 | pattern: \\\\b[A-Z]\\\\d{8,9}\\\\b | mask_token: [PASSPORT] | mask_strategy: full\\n\\n9) classifier_id: CLS-PII-DL-001 | name: Driver\'s License | category: PII.IDENTIFIER.DRIVERS_LICENSE | type: regex | priority: 3 | confidence_threshold: 0.85 | pattern: \\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b | mask_token: [DRIVERS_LICENSE] | mask_strategy: full\\n\\n10) classifier_id: CLS-PII-ADDRESS-001 | name: Residential / Work Street Address | category: PII.LOCATION.STREET_ADDRESS | type: regex | priority: 4 | confidence_threshold: 0.85 | pattern: \\\\b\\\\d{1,5}[ \\\\t]+[A-Za-z0-9., \\\\t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \\\\t]+(?:Suite|Ste|Apt|Unit|#)[ \\\\t]+[A-Za-z0-9-]+)?,[ \\\\t]+[A-Za-z \\\\t]+,[ \\\\t]+[A-Z]{2}[ \\\\t]+\\\\d{5}(?:-\\\\d{4})?\\\\b|\\\\b\\\\d{1,5}[ \\\\t]+[A-Za-z0-9., \\\\t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \\\\t]+(?:Suite|Ste|Apt|Unit|#)[ \\\\t]+[A-Za-z0-9-]+)?\\\\b | mask_token: [STREET_ADDRESS] | mask_strategy: partial (mask street number + name, keep city/state/zip) | horizontal-whitespace bounded\\n\\n11) classifier_id: CLS-PII-NAME-001 | name: Full Name / Individual Name | category: PII.PERSON_NAME | type: ner | entity_types: [\\"PERSON\\"] | priority: 5 | confidence_threshold: 0.8 | mask_token: [NAME] | mask_strategy: full\\n\\n12) classifier_id: CLS-PHI-MED-ID-001 | name: Medical Case Ref / Patient Member ID | category: PHI.MEDICAL_IDENTIFIER | type: regex | priority: 2 | confidence_threshold: 0.9 | pattern: \\\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\\\b | mask_token: [MEDICAL_ID] | mask_strategy: full\\n\\n13) classifier_id: CLS-PHI-CONDITION-001 | name: Health Condition / Prescription / Allergy | category: PHI.HEALTH_DATA | type: dictionary_and_heuristic | priority: 3 | confidence_threshold: 0.85 | terms: [\\"penicillin allergy\\", \\"allergy\\", \\"Hypertension\\", \\"hypertension\\", \\"prescription adjustment\\", \\"emergency dispensation\\", \\"medical dispensation\\"] | mask_token: [HEALTH_DATA] | mask_strategy: full\\n\\n14) classifier_id: CLS-PII-USERNAME-001 | name: System Account Username | category: PII.IDENTIFIER.USERNAME | type: regex_context | priority: 3 | confidence: 0.86 | confidence_threshold: 0.85 | pattern: (?i:\\\\b(?:Account Name|Username|User Name|Login|Account):[ \\\\t]*)(?!Role\\\\b)([a-zA-Z][a-zA-Z0-9._-]{2,30})\\\\b | mask_token: [USERNAME] | mask_strategy: full | note: label-anchored with negative lookahead guard against \'Role\' (D-9)\\n\\n15) classifier_id: CLS-PHI-INSURANCE-MEMBER-ID-001 | name: Health Insurance Member ID / Policy Number | category: PHI.MEDICAL_IDENTIFIER.HEALTH_INSURANCE_MEMBER_ID | type: regex | priority: 2 | confidence: 0.9 | confidence_threshold: 0.85 | pattern: \\\\b(?:HI|INS|POL|GRP)-[A-Za-z0-9-]{6,16}\\\\b|(?i:\\\\bHealth Insurance (?:Number|ID|Member ID):[ \\\\t]*)([A-Za-z0-9-]+)\\\\b | mask_token: [INSURANCE_ID] | mask_strategy: partial (keep plan prefix + suffix code, mask member digits)\\n\\n=== EXTRACTION / EMISSION SUMMARY ===\\n- Regex-based: 13 (CLS-PII-SSN-001, CLS-PII-CC-001, CLS-PII-EMAIL-001, CLS-PII-PHONE-001, CLS-PII-IP-001, CLS-PII-DOB-001, CLS-PII-IBAN-001, CLS-PII-PASSPORT-001, CLS-PII-DL-001, CLS-PII-ADDRESS-001, CLS-PHI-MED-ID-001, CLS-PII-USERNAME-001 [regex_context], CLS-PHI-INSURANCE-MEMBER-ID-001).\\n- NER-based: 1 (CLS-PII-NAME-001, entity_types: PERSON).\\n- Dictionary + heuristic: 1 (CLS-PHI-CONDITION-001, 7 terms).\\n- Validator: Luhn soft-fail on CLS-PII-CC-001 (pass 0.99 / fail 0.86, threshold 0.85).\\n- Priority tiers: 1 (SSN, Credit Card), 2 (Email, Phone, IBAN, Medical ID, Insurance Member ID), 3 (IP, DOB, Passport, DL, Username, Condition), 4 (Street Address), 5 (Name/NER).\\n- Confidence thresholds range 0.8 (Name) to 0.95 (SSN, Email).\\n- Categories in scope: PII (PERSON_NAME, IDENTIFIER[SSN, NATIONAL_ID, PASSPORT, DRIVERS_LICENSE, USERNAME], CONTACT[EMAIL, PHONE_NUMBER], LOCATION[STREET_ADDRESS, IP_ADDRESS], FINANCIAL[CREDIT_CARD, BANK_ACCOUNT, IBAN, CVV], DEMOGRAPHIC[DATE_OF_BIRTH]) and PHI (MEDICAL_IDENTIFIER[PATIENT_ID, MEDICAL_CASE_REF, HEALTH_INSURANCE_MEMBER_ID], HEALTH_DATA[ALLERGY, CONDITION, PRESCRIPTION, CLINICAL_NOTE]).\\n- pending_admin_review: [] (empty — no unapproved deltas).\\n\\nRevision history notes: rev-001 (1.0.0) initial baseline with 13 classifiers; rev-002 (1.1.0) added CLS-PII-USERNAME-001 and CLS-PHI-INSURANCE-MEMBER-ID-001 and modified CLS-PII-CC-001, CLS-PII-IBAN-001, CLS-PII-ADDRESS-001. Cite active pinned revision rev-002 for all deterministic span emission."\n}'}
