2026-10-19 12:18:03 BST | INFO     | NeuroSan:_log:821 - NeuroSan - {"message": "Result from OpenAI Tool: [{'type': 'server_tool_call', 'name': 'code_interpreter', 'id': 'ci_07814c033db67006006ad5fc5ac52c87d2bbc44d5120e8261e', 'args': {'code': 'import re\nimport json\nfrom collections import defaultdict\n\n# Document and patterns\nDOC = """1. Full Name: Marcus Aurelius Vance\n2. System Username: mavance_admin\n3. Email Address: m.vance@gmail.com\n4. Primary Phone: +1 (555) 712-4091\n5. User Role: Senior Systems Administrator\n6. Passport Number: N89201492\n7. Last Login IP: 192.168.10.45\n8. Residential Address: 100 Cyberdyne Way, Suite 400, Portland, OR 97201\n9. Social Security Number: 483-92-1049\n10. Health Insurance Number: HI-902849102-B"""\n\npatterns = [\n    ("CLS-PII-SSN-001", "PII.IDENTIFIER.SSN", r"\\b\\d{3}-\\d{2}-\\d{4}\\b", 0.95, 1),\n    ("CLS-PII-CC-001", "PII.FINANCIAL.CREDIT_CARD", r"\\b(?:4\\d{3}|5[1-5]\\d{2}|6011|3[47]\\d{2})[- ]?\\d{4}[- ]?\\d{4}[- ]?\\d{4}\\b|\\b\\d{4}-\\d{4}-\\d{4}-\\d{4}\\b", 0.95, 1),\n    ("CLS-PII-EMAIL-001", "PII.CONTACT.EMAIL", r"\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b", 0.95, 2),\n    ("CLS-PII-PHONE-001", "PII.CONTACT.PHONE_NUMBER", r"(?:\\+?1[-. ]?)?(?:\\(\\d{3}\\)|\\b\\d{3})[-. ]?\\d{3}[-. ]?\\d{4}\\b", 0.90, 2),\n    ("CLS-PII-IP-001", "PII.LOCATION.IP_ADDRESS", r"\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\b|\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\b", 0.90, 3),\n    ("CLS-PII-DOB-001", "PII.DEMOGRAPHIC.DATE_OF_BIRTH", r"\\b(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])\\b|\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+(?:0?[1-9]|[12]\\d|3[01]),\\s+(?:19|20)\\d{2}\\b", 0.85, 3),\n    ("CLS-PII-IBAN-001", "PII.FINANCIAL.BANK_ACCOUNT", r"\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]{4}){3,7}\\b", 0.90, 2),\n    ("CLS-PII-PASSPORT-001", "PII.IDENTIFIER.PASSPORT", r"\\b[A-Z]\\d{8,9}\\b", 0.85, 3),\n    ("CLS-PII-DL-001", "PII.IDENTIFIER.DRIVERS_LICENSE", r"\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\b", 0.85, 3),\n    ("CLS-PII-ADDRESS-001", "PII.LOCATION.STREET_ADDRESS", r"\\b\\d{1,5}\\s+[A-Za-z0-9\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\s.,#]+)?(?:,\\s+[A-Za-z\\s]+,\\s+[A-Z]{2}\\s+\\d{5}(?:-\\d{4})?)?\\b", 0.85, 4),\n    ("CLS-PHI-MED-ID-001", "PHI.MEDICAL_IDENTIFIER", r"\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\b", 0.90, 2),\n    ("CLS-PHI-CONDITION-001", "PHI.HEALTH_DATA", r"\\b(?:penicillin allergy|allergy|Hypertension|hypertension|prescription adjustment|emergency dispensation|medical dispensation)\\b", 0.85, 3),\n    ("CLS-PII-NAME-001", "PII.PERSON_NAME", r"\\b[A-Z][a-z]+(?:\\s+[A-Z][a-z]+){1,2}\\b", 0.80, 5)\n]\n\nstopwords = {\n    "Full", "Name", "System", "Username", "Email", "Address", "Primary", "Phone", \n    "User", "Role", "Senior", "Systems", "Administrator", "Passport", "Number", \n    "Last", "Login", "IP", "Residential", "Suite", "Portland", "Cyberdyne", "Way",\n    "Social", "Security", "Health", "Insurance"\n}\n\n# Function to apply patterns to each line\ndef match_patterns(doc, patterns):\n    matches = []\n    for line_no, line in enumerate(doc.splitlines(keepends=True)):\n        offset = len("\\n".join(doc.splitlines(keepends=True)[:line_no]))\n        for pattern in patterns:\n            classifier_id, category, regex, confidence, priority = pattern\n            for match in re.finditer(regex, line):\n                start, end = match.span()\n                matched_text = match.group().rstrip()\n                end = start + len(matched_text) # Adjust end for trailing whitespace\n                # Handle PII Name heuristic\n                is_name = (\n                    category == "PII.PERSON_NAME" and\n                    matched_text.split()[0] not in stopwords and\n                    (end < len(line) and line[end] != \':\')\n                )\n                if category != "PII.PERSON_NAME" or is_name:\n                    matches.append({\n                        "classifier_id": classifier_id,\n                        "category": category,\n                        "match": matched_text,\n                        "offset": (offset + start, offset + end),\n                        "line": line.strip(),\n                        "confidence": confidence,\n                        "priority": priority\n                    })\n    return matches\n\n\n# Function to resolve overlaps and identify unmatched identifiers\ndef resolve_overlaps_and_identifiers(matches, doc):\n    matches.sort(key=lambda m: (m[\'offset\'][0], -(m[\'offset\'][1] - m[\'offset\'][0]), m[\'priority\'], -m[\'confidence\']))\n    \n    resolved_matches = []\n    occupied = [False] * len(doc)\n    \n    for match in matches:\n        s, e = match[\'offset\']\n        if not any(occupied[s:e]):\n            resolved_matches.append(match)\n            for i in range(s, e):\n                occupied[i] = True\n    \n    unresolved_identifiers = []\n    identifier_regex = re.compile(r\'\\b[A-Z]{1,3}-[A-Za-z0-9-]{4,16}\\b\')\n    for match in identifier_regex.finditer(doc):\n        if not any(occupied[i] for i in range(*match.span())):\n            unresolved_identifiers.append({\n                "text": match.group(),\n                "offset": match.span()\n            })\n    \n    return resolved_matches, unresolved_identifiers\n\n# Applying the functions\nmatches = match_patterns(DOC, patterns)\nresolved_matches, unresolved_identifiers = resolve_overlaps_and_identifiers(matches, DOC)\n\n# Prepare the output JSON\ndetections = []\ncategory_counts = defaultdict(int)\n\nfor match in resolved_matches:\n    context_note = ""\n    if match["category"] == "PII.LOCATION.IP_ADDRESS":\n        context_note = "log/transaction record"\n    \n    detections.append({\n        "classifier_id": match["classifier_id"],\n        "category": match["category"],\n        "match": match["match"],\n