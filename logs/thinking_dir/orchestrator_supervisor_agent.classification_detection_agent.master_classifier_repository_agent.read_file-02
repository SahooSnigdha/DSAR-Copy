\\d{4})|(?:\\\\s\\\\d{4}\\\\s\\\\d{4}\\\\s\\\\d{4})))\\\\b\",\n      \"confidence_threshold\": 0.85,\n      \"priority\": 1,\n      \"mask_token\": \"[CREDIT_CARD]\",\n      \"description\": \"Major credit card numbers with line-wrap support (Variant A hyphen-newline normalization / D-8) and soft-fail Luhn validation.\",\n      \"validator\": \"luhn_soft_fail\",\n      \"validator_rules\": {\n        \"luhn_pass_confidence\": 0.99,\n        \"luhn_fail_confidence\": 0.86,\n        \"threshold\": 0.85\n      },\n      \"mask_strategy\": \"partial\",\n      \"partial_mask_description\": \"PCI DSS standard: mask all digits except the last 4 digits with solid black squares, preserve delimiters/hyphens.\"\n    },\n    {\n      \"classifier_id\": \"CLS-PII-EMAIL-001\",\n      \"name\": \"Email Address\",\n      \"category\": \"PII.CONTACT.EMAIL\",\n      \"type\": \"regex\",\n      \"pattern\": \"\\\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}\\\\b\",\n      \"confidence_threshold\": 0.95,\n      \"priority\": 2,\n      \"mask_token\": \"[EMAIL]\",\n      \"description\": \"Standard RFC-compliant email address format.\",\n      \"mask_strategy\": \"partial\",\n      \"partial_mask_description\": \"Mask local username before @ with solid black squares, preserve @ and domain name.\"\n    },\n    {\n      \"classifier_id\": \"CLS-PII-PHONE-001\",\n      \"name\": \"Telephone Number\",\n      \"category\": \"PII.CONTACT.PHONE_NUMBER\",\n      \"type\": \"regex\",\n      \"pattern\": \"(?:\\\\+?1[-. ]?)?(?:\\\\(\\\\d{3}\\\\)|\\\\b\\\\d{3})[-. ]?\\\\d{3}[-. ]?\\\\d{4}\\\\b\",\n      \"confidence_threshold\": 0.9,\n      \"priority\": 2,\n      \"mask_token\": \"[PHONE_NUMBER]\",\n      \"description\": \"North American phone numbers with optional country code, parentheses, dashes, or dots.\",\n      \"mask_strategy\": \"partial\",\n      \"partial_mask_description\": \"Preserve country code (e.g. +1) and formatting punctuation, mask area and subscriber digits with solid black squares.\"\n    },\n    {\n      \"classifier_id\": \"CLS-PII-IP-001\",\n      \"name\": \"IP Address (IPv4 & IPv6)\",\n      \"category\": \"PII.LOCATION.IP_ADDRESS\",\n      \"type\": \"regex\",\n      \"pattern\": \"\\\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\b|\\\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\\\b\",\n      \"confidence_threshold\": 0.9,\n      \"priority\": 3,\n      \"mask_token\": \"[IP_ADDRESS]\",\n      \"description\": \"IPv4 dotted-decimal and IPv6 8-group addresses.\",\n      \"mask_strategy\": \"full\"\n    },\n    {\n      \"classifier_id\": \"CLS-PII-DOB-001\",\n      \"name\": \"Date of Birth\",\n      \"category\": \"PII.DEMOGRAPHIC.DATE_OF_BIRTH\",\n      \"type\": \"regex\",\n      \"pattern\": \"\\\\b(?:19|20)\\\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])\\\\b|\\\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\\\s+(?:0?[1-9]|[12]\\\\d|3[01]),\\\\s+(?:19|20)\\\\d{2}\\\\b\",\n      \"confidence_threshold\": 0.85,\n      \"priority\": 3,\n      \"mask_token\": \"[DATE_OF_BIRTH]\",\n      \"description\": \"ISO-8601 dates and month-name formatted dates of birth.\",\n      \"mask_strategy\": \"full\"\n    },\n    {\n      \"classifier_id\": \"CLS-PII-IBAN-001\",\n      \"name\": \"Bank Account (IBAN)\",\n      \"category\": \"PII.FINANCIAL.IBAN\",\n      \"type\": \"regex\",\n      \"pattern\": \"\\\\b[A-Z]{2}\\\\d{2}(?:\\\\s?[A-Z0-9]{4}){3,7}(?:\\\\s?[A-Z0-9]{1,4})?\\\\b\",\n      \"confidence_threshold\": 0.9,\n      \"priority\": 2,\n      \"mask_token\": \"[IBAN]\",\n      \"description\": \"International Bank Account Numbers with optional spacing and variable-length final block.\",\n      \"mask_strategy\": \"partial\",\n      \"partial_mask_description\": \"Preserve country code + check digits (first 4 chars) and last 2-4 digits, mask routing and account alphanumeric chars with solid black squares.\"\n    },\n    {\n      \"classifier_id\": \"CLS-PII-PASSPORT-001\",\n      \"name\": \"Passport Number\",\n      \"category\": \"PII.IDENTIFIER.PASSPORT\",\n      \"type\": \"regex\",\n      \"pattern\": \"\\\\b[A-Z]\\\\d{8,9}\\\\b\",\n      \"confidence_threshold\": 0.85,\n      \"priority\": 3,\n      \"mask_token\": \"[PASSPORT]\",\n      \"description\": \"Standard alphanumeric passport identifiers.\",\n      \"mask_strategy\": \"full\"\n    },\n    {\n      \"classifier_id\": \"CLS-PII-DL-001\",\n      \"name\": \"Driver's License\",\n      \"category\": \"PII.IDENTIFIER.DRIVERS_LICENSE\",\n      \"type\": \"regex\",\n      \"pattern\": \"\\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b\",\n      \"confidence_threshold\": 0.85,\n      \"priority\": 3,\n      \"mask_token\": \"[DRIVERS_LICENSE]\",\n      \"description\": \"Standard state driver's license numbers with DL- prefix.\",\n      \"mask_strategy\": \"full\"\n    },\n    {\n      \"classifier_id\": \"CLS-PII-ADDRESS-001\",\n      \"name\": \"Residential / Work Street Address\",\n      \"category\": \"PII.LOCATION.STREET_ADDRESS\",\n      \"type\": \"regex\",\n      \"pattern\": \"\\\\b\\\\d{1,5}[ \\\\t]+[A-Za-z0-9., \\\\t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \\\\t]+(?:Suite|Ste|Apt|Unit|#)[ \\\\t]+[A-Za-z0-9-]+)?,[ \\\\t]+[A-Za-z \\\\t]+,[ \\\\t]+[A-Z]{2}[ \\\\t]+\\\\d{5}(?:-\\\\d{4})?\\\\b|\\\\b\\\\d{1,5}[ \\\\t]+[A-Za-z0-9., \\\\t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \\\\t]+(?:Suite|Ste|Apt|Unit|#)[ \\\\t]+[A-Za-z0-9-]+)?\\\\b\",\n      \"confidence_threshold\": 0.85,\n      \"priority\": 4,\n      \"mask_token\": \"[STREET_ADDRESS]\",\n      \"description\": \"Physical postal street address constrained to horizontal whitespace to prevent newline over-matching.\",\n      \"mask_strategy\": \"partial\",\n      \"partial_mask_description\": \"Mask street number and street name with solid black squares, preserve city, state, zip code.\"\n 