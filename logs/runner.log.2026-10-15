de": "mask_and_surrogate",\n  "review_gate": {\n    "enabled": true,\n    "threshold": 0.75,\n    "always_review": ["SSN", "CREDIT_CARD", "CVV", "IBAN", "DOB"]\n  }\n}\n```\n\n## Expected output\nRepresentative subset shown; full page output contains 14 spans across the categories listed below.\n\n```json\n{\n  "request_id": "req-redact-2025-0001",\n  "document_id": "sample_pii_test_data.txt",\n  "page_index": 0,\n  "page_unit_id": "sample_pii_test_data.txt#p0",\n  "status": "assessed",\n  "spans": [\n    {\n      "span_id": "sp-0001",\n      "start": 0,\n      "end": 15,\n      "text": "Jane Q. Sample",\n      "category": "PERSON_NAME",\n      "subcategory": "customer",\n      "confidence": 0.99,\n      "action": "surrogate",\n      "mask": "████████████",\n      "surrogate": "[PERSON_NAME_1]",\n      "review_required": false,\n      "reason": "name pattern + customer profile context"\n    },\n    {\n      "span_id": "sp-0002",\n      "start": 42,\n      "end": 52,\n      "text": "1985-04-12",\n      "category": "DOB",\n      "subcategory": "date_of_birth",\n      "confidence": 0.98,\n      "action": "surrogate",\n      "mask": "██████████",\n      "surrogate": "[DOB_1]",\n      "review_required": true,\n      "reason": "always-review category"\n    },\n    {\n      "span_id": "sp-0003",\n      "start": 78,\n      "end": 89,\n      "text": "123-45-6789",\n      "category": "SSN",\n      "subcategory": "us_ssn",\n      "confidence": 0.99,\n      "action": "mask_and_surrogate",\n      "mask": "XXX-XX-6789",\n      "surrogate": "[SSN_1]",\n      "review_required": true,\n      "reason": "always-review category"\n    },\n    {\n      "span_id": "sp-0004",\n      "start": 120,\n      "end": 132,\n      "text": "+1-555-0142",\n      "category": "PHONE",\n      "subcategory": "mobile",\n      "confidence": 0.97,\n      "action": "surrogate",\n      "mask": "███████████",\n      "surrogate": "[PHONE_1]",\n      "review_required": false,\n      "reason": "phone pattern"\n    },\n    {\n      "span_id": "sp-0005",\n      "start": 150,\n      "end": 174,\n      "text": "jane.sample@example.com",\n      "category": "EMAIL",\n      "subcategory": "personal",\n      "confidence": 0.99,\n      "action": "surrogate",\n      "mask": "██████████████████████",\n      "surrogate": "[EMAIL_1]",\n      "review_required": false,\n      "reason": "email pattern"\n    },\n    {\n      "span_id": "sp-0006",\n      "start": 200,\n      "end": 232,\n      "text": "123 Example St, Springfield, IL 62704",\n      "category": "ADDRESS",\n      "subcategory": "postal",\n      "confidence": 0.96,\n      "action": "surrogate",\n      "mask": "████████████████████████████████",\n      "surrogate": "[ADDRESS_1]",\n      "review_required": false,\n      "reason": "address pattern + profile context"\n    },\n    {\n      "span_id": "sp-0007",\n      "start": 260,\n      "end": 270,\n      "text": "192.0.2.44",\n      "category": "IP_ADDRESS",\n      "subcategory": "ipv4",\n      "confidence": 0.98,\n      "action": "surrogate",\n      "mask": "██████████",\n      "surrogate": "[IP_ADDRESS_1]",\n      "review_required": false,\n      "reason": "IPv4 pattern"\n    },\n    {\n      "span_id": "sp-0008",\n      "start": 300,\n      "end": 319,\n      "text": "4111 1111 1111 1111",\n      "category": "CREDIT_CARD",\n      "subcategory": "pan",\n      "confidence": 0.99,\n      "action": "mask",\n      "mask": "**** **** **** 1111",\n      "surrogate": "[CREDIT_CARD_1]",\n      "review_required": true,\n      "reason": "always-review category"\n    },\n    {\n      "span_id": "sp-0009",\n      "start": 340,\n      "end": 343,\n      "text": "123",\n      "category": "CVV",\n      "subcategory": "card_verification_value",\n      "confidence": 0.95,\n      "action": "mask",\n      "mask": "***",\n      "surrogate": "[CVV_1]",\n      "review_required": true,\n      "reason": "always-review category"\n    },\n    {\n      "span_id": "sp-0010",\n      "start": 380,\n      "e