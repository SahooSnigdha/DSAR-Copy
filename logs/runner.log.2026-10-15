: 2048},\n      {\"page_id\": \"d26f3fb12d9f625e462ed872521e86d9\", \"index\": 1, \"length\": 712}\n    ],\n    \"approval_matrix\": [],\n    \"classifier_ruleset_version\": \"pii_phi_default_v1\",\n    \"trip_binding\": [\"p0\", \"p1\"],\n    \"halt\": true,\n    \"halt_reason\": \"detection_output_mismatch\",\n    \"halt_detail\": \"Detection stage returned generic placeholder spans (e.g., 'Jane Q. Sample', '123-45-6789') that do not correspond to the actual page content ('Sarah Elizabeth Jenkins', '483-92-1049'), with non-derived offsets. Advancing would corrupt the review payload and approval record.\",\n    \"advanced\": false,\n    \"artifact_produced\": false,\n    \"audit_log_entry\": {\"event\": \"detection_output_mismatch\", \"page_id\": \"85ebd7b8574fed478b13782f264e6fba\", \"action\": \"halt_advancement\"},\n    \"open_items\": [\n      \"Detection stage must re-run on real page bytes and return content-faithful spans/offsets for both pages.\",\n      \"Confirm or override provisional 2048-char page size.\",\n      \"Confirm pinned classifier ruleset version.\",\n      \"Human approval required per page; no auto-advance.\"\n    ]\n  }\n}\n```"}
