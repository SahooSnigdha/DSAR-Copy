x\\",\\"priority\\":1,\\"threshold\\":0.95,\\"conf\\":0.99,\\n  \\"pattern\\":r\\"\\\\b\\\\d{3}-\\\\d{2}-\\\\d{4}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-CC-001\\",\\"category\\":\\"PII.FINANCIAL.CREDIT_CARD\\",\\"type\\":\\"regex\\",\\"priority\\":1,\\"threshold\\":0.95,\\"conf\\":0.99,\\n  \\"pattern\\":r\\"\\\\b(?:4\\\\d{3}|5[1-5]\\\\d{2}|6011|3[47]\\\\d{2})[- ]?\\\\d{4}[- ]?\\\\d{4}[- ]?\\\\d{4}\\\\b|\\\\b\\\\d{4}-\\\\d{4}-\\\\d{4}-\\\\d{4}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-EMAIL-001\\",\\"category\\":\\"PII.CONTACT.EMAIL\\",\\"type\\":\\"regex\\",\\"priority\\":2,\\"threshold\\":0.95,\\"conf\\":0.99,\\n  \\"pattern\\":r\\"\\\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-PHONE-001\\",\\"category\\":\\"PII.CONTACT.PHONE_NUMBER\\",\\"type\\":\\"regex\\",\\"priority\\":2,\\"threshold\\":0.90,\\"conf\\":0.97,\\n  \\"pattern\\":r\\"(?:\\\\+?1[-. ]?)?(?:\\\\(\\\\d{3}\\\\)|\\\\b\\\\d{3})[-. ]?\\\\d{3}[-. ]?\\\\d{4}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-IP-001\\",\\"category\\":\\"PII.LOCATION.IP_ADDRESS\\",\\"type\\":\\"regex\\",\\"priority\\":3,\\"threshold\\":0.90,\\"conf\\":0.98,\\n  \\"pattern\\":r\\"\\\\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\b|\\\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-DOB-001\\",\\"category\\":\\"PII.DEMOGRAPHIC.DATE_OF_BIRTH\\",\\"type\\":\\"regex\\",\\"priority\\":3,\\"threshold\\":0.85,\\"conf\\":0.95,\\n  \\"pattern\\":r\\"\\\\b(?:19|20)\\\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])\\\\b|\\\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\\\s+(?:0?[1-9]|[12]\\\\d|3[01]),\\\\s+(?:19|20)\\\\d{2}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-IBAN-001\\",\\"category\\":\\"PII.FINANCIAL.BANK_ACCOUNT\\",\\"type\\":\\"regex\\",\\"priority\\":2,\\"threshold\\":0.90,\\"conf\\":0.96,\\n  \\"pattern\\":r\\"\\\\b[A-Z]{2}\\\\d{2}(?:\\\\s?[A-Z0-9]{4}){3,7}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-PASSPORT-001\\",\\"category\\":\\"PII.IDENTIFIER.PASSPORT\\",\\"type\\":\\"regex\\",\\"priority\\":3,\\"threshold\\":0.85,\\"conf\\":0.95,\\n  \\"pattern\\":r\\"\\\\b[A-Z]\\\\d{8,9}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-DL-001\\",\\"category\\":\\"PII.IDENTIFIER.DRIVERS_LICENSE\\",\\"type\\":\\"regex\\",\\"priority\\":3,\\"threshold\\":0.85,\\"conf\\":0.92,\\n  \\"pattern\\":r\\"\\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PII-ADDRESS-001\\",\\"category\\":\\"PII.LOCATION.STREET_ADDRESS\\",\\"type\\":\\"regex\\",\\"priority\\":4,\\"threshold\\":0.85,\\"conf\\":0.92,\\n  \\"pattern\\":r\\"\\\\b\\\\d{1,5}\\\\s+[A-Za-z0-9\\\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\\\s.,#]+)?(?:,\\\\s+[A-Za-z\\\\s]+,\\\\s+[A-Z]{2}\\\\s+\\\\d{5}(?:-\\\\d{4})?)?\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PHI-MED-ID-001\\",\\"category\\":\\"PHI.MEDICAL_IDENTIFIER\\",\\"type\\":\\"regex\\",\\"priority\\":2,\\"threshold\\":0.90,\\"conf\\":0.95,\\n  \\"pattern\\":r\\"\\\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\\\b\\"},\\n {\\"classifier_id\\":\\"CLS-PHI-CONDITION-001\\",\\"category\\":\\"PHI.HEALTH_DATA\\",\\"type\\":\\"dictionary_and_heuristic\\",\\"priority\\":3,\\"threshold\\":0.85,\\"conf\\":0.90,\\n  \\"terms\\":[\\"penicillin allergy\\",\\"allergy\\",\\"Hypertension\\",\\"hypertension\\",\\"prescription adjustment\\",\\"emergency dispensation\\",\\"medical dispensation\\"]},\\n {\\"classifier_id\\":\\"CLS-PII-NAME-001\\",\\"category\\":\\"PII.PERSON_NAME\\",\\"type\\":\\"ner\\",\\"entity_types\\":[\\"PERSON\\"],\\"priority\\":5,\\"threshold\\":0.80,\\"conf\\":0.95},\\n]\\n\\ndef line_of(pos):\\n    return DOC.count(\\"\\\\n\\", 0, pos) + 1\\n\\ncandidates = []\\nraw_counts = {}\\n\\n# --- Regex classifiers ---\\nfor cl in CLS:\\n    if cl[\\"type\\"] != \\"regex\\":\\n        continue\\n    rx = re.compile(cl[\\"pattern\\"]