mber, NINO, Driving Licence, Vehicle Plate, UTR, +44 Telephone), conversational/spoken Date of Birth, and customer service agent/titled names to authoritative pinned classifiers approved by Human Admin."\n  },\n  "categories": {\n    "PII": {\n      "description": "Personally Identifiable Information",\n      "subcategories": {\n        "PERSON_NAME": { "description": "Full or partial names of individuals" },\n        "IDENTIFIER": {\n          "description": "Government or official identity numbers",\n          "types": ["SSN","NATIONAL_ID","PASSPORT","DRIVERS_LICENSE","USERNAME","UK_NINO","UK_DRIVING_LICENCE","UK_VEHICLE_PLATE","UK_UTR","EMPLOYEE_ID"]\n        },\n        "CONTACT": { "description": "Direct communication contact information", "types": ["EMAIL","PHONE_NUMBER"] },\n        "LOCATION": { "description": "Physical addresses and network locations", "types": ["STREET_ADDRESS","IP_ADDRESS","UK_POSTCODE"] },\n        "FINANCIAL": { "description": "Banking, payment, and transaction identifiers", "types": ["CREDIT_CARD","BANK_ACCOUNT","IBAN","CVV","UK_SORT_CODE","BANK_ACCOUNT_NUMBER"] },\n        "DEMOGRAPHIC": { "description": "Personal demographic attributes", "types": ["DATE_OF_BIRTH"] }\n      }\n    },\n    "PHI": {\n      "description": "Protected Health Information",\n      "subcategories": {\n        "MEDICAL_IDENTIFIER": { "description": "Patient, member, or clinical record identifiers", "types": ["PATIENT_ID","MEDICAL_CASE_REF","HEALTH_INSURANCE_MEMBER_ID","UK_NHS_NUMBER"] },\n        "HEALTH_DATA": { "description": "Medical conditions, diagnoses, allergies, and prescriptions", "types": ["ALLERGY","CONDITION","PRESCRIPTION","CLINICAL_NOTE"] }\n      }\n    }\n  },\n  "classifiers": [\n    { "classifier_id": "CLS-PII-SSN-001", "name": "Social Security Number / National ID", "category": "PII.IDENTIFIER.SSN", "type": "regex", "pattern": "\\\\b\\\\d{3}-\\\\d{2}-\\\\d{4}\\\\b", "confidence_threshold": 0.95, "priority": 1, "mask_token": "[SSN]", "descrip