# username: consuming-prefix + capture group (avoids fixed-width lookbehind error)
USER = r'(?:\b(?:Account Name|Username|Account|Login|User)[ \t]*:[ \t]*)([a-z][a-z0-9._\-]{2,31})(?![A-Za-z0-9.@\-])'

