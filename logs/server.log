# Optional metadata describing this agent network
    "metadata": {
        "sample_queries": [
            "Start a redaction job on this patient intake PDF and tell me how many pages it was split into.",
            "I uploaded a contract document — show me the current page with the unredacted highlights and the masked version so I can approve it.",
            "On page 3 I removed one phone number the classifier flagged and added a missed account ID; log that feedback and tell me the status of the document.",
            "What classifier ruleset version is pinned for this document, and are there any pending proposals waiting for admin review?",
            "All pages are approved now — please finalize the hardened obfuscated file and confirm the document is completed.",
            "I'm rejecting page 2 — the detection missed several names. Re-classify it and don't advance the page loop.",
            "Give me a status summary: which pages are approved, which are still pending, and what's blocking completion?"
        ],
        "date_created": "2026-10-15T11:10:44.898747+00:00",
        "date_modified": "2026-10-15T11:10:44.898747+00:00"
