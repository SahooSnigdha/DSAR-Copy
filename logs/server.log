{"message": "Query: 
import re, json

text = '''1. Full Name: Marcus Aurelius Vance
2. System Username: mavance_admin
3. Email Address: m.vance@vanceresearch-labs.org
4. Primary Phone: +1 (555) 712-4091
5. User Role: Senior Systems Administrator
6. Passport Number: N89201492
7. Last Login IP: 192.168.10.45'''

classifiers = [
 {"classifier_id":"CLS-PII-SSN-001","category":"PII.IDENTIFIER.SSN","type":"regex","pattern":r"\b\d{3}-\d{2}-\d{4}\b","thr":0.95,"priority":1},
 {"classifier_id":"CLS-PII-CC-001","category":"PII.FINANCIAL.CREDIT_CARD","type":"regex","pattern":r"\b(?:4\d{3}|5[1-5]\d{2}|6011|3[47]\d{2})[- ]?\d{4}[- ]?\d{4}[- ]?\d{4}\b|\b\d{4}-\d{4}-\d{4}-\d{4}\b","thr":0.95,"priority":1},
 {"classifier_id":"CLS-PII-EMAIL-001","category":"PII.CONTACT.EMAIL","type":"regex","pattern":r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b","thr":0.95,"priority":2},
 {"classifier_id":"CLS-PII-PHONE-001","category":"PII.CONTACT.PHONE_NUMBER","type":"regex","pattern":r"(?:\+?1[-. ]?)?(?:\(\d{3}\)|\b\d{3})[-. ]?\d{3}[-. ]?\d{4}\b","thr":0.90,"priority":2},
 {"classifier_id":"CLS-PII-IP-001","category":"PII.LOCATION.IP_ADDRESS","type":"regex","pattern":r"\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b|\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\b","thr":0.90,"priority":3},
 {"classifier_id":"CLS-PII-DOB-001","category":"PII.DEMOGRAPHIC.DATE_OF_BIRTH","type":"regex","pattern":r"\b(?:19|20)\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\d|3[01])\b|\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\s+(?:0?[1-9]|[12]\d|3[01]),\s+(?:19|20)\d{2}\b","thr":0.85,"priority":3},
 {"classifier_id":"CLS-PII-IBAN-001","category":"PII.FINANCIAL.BANK_ACCOUNT","type":"regex","pattern":r"\b[A-Z]{2}\d{2}(?:\s?[A-Z0-9]{4}){3,7}\b","thr":0.90,"priority":2},
 {"classifier_id":"CLS-PII-PASSPORT-001","category":"PII.IDENTIFIER.PASSPORT","type":"regex","pattern":r"\b[A-Z]\d{8,9}\b","thr":0.85,"priority":3},
 {"classifier_id":"CLS-PII-DL-001","category":"PII.IDENTIFIER.DRIVERS_LICENSE","type":"regex","pattern":r"\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\b","thr":0.85,"priority":3},
 {"classifier_id":"CLS-PII-ADDRESS-001","category":"PII.LOCATION.STREET_ADDRESS","type":"regex","pattern":r"\b\d{1,5}\s+[A-Za-z0-9\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\s.,#]+)?(?:,\s+[A-Za-z\s]+,\s+[A-Z]{2}\s+\d{5}(?:-\d{4})?)?\b","thr":0.85,"priority":4},
 {"classifier_id":"CLS-PHI-MED-ID-001","category":"PHI.MEDICAL_IDENTIFIER","type":"regex","pattern":r"\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\b","thr":0.90,"priority":2},
]

condition_terms = ["penicillin allergy","allergy","Hypertension","hypertension","prescription adjustment","emergency dispensation","medical dispensation"]
condition_thr=0.85; condition_priority=3

candidates=[]
# regex classifiers
for c in classifiers:
    for m in re.finditer(c["pattern"], text):
        candidates.append({"start":m.start(),"end":m.end(),"text":m.group(0),"category":c["category"],
                           "classifier_id":c["classifier_id"],"confidence":c["thr"],"priority":c["priority"]})

# dictionary + heuristic PHI condition
for t in condition_terms:
    for m in re.finditer(r"\b"+re.escape(t)+r"\b", text, flags=re.IGNORECASE):
        candidates.append({"start":m.start(),"end":m.end(),"text":m.group(0),"category":"PHI.HEALTH_DATA",
                           "classifier_id":"CLS-PHI-CONDITION-001","confidence":condition_thr,"priority":condition_priority})

# NER person approximation (deterministic): runs of Capitalized name tokens, excluding role-labeled fields
# Exclude any candidate preceded by a label like "User Role:" (role, not a person).
name_candidates=[]
for m in re.finditer(r"\b([A-Z][a-z]+(?:\s+[A-Z][a-z]+){1,3})\b", text):
    span_start=m.start()
    # find field label preceding on same line
    line_start=text.rfind("\n",0,span_start)+1
    label=text[line_start:span_start]
    # role exclusion
    if "User Role" in label:
        continue
    # crude role-word exclusion
    words=m.group(1).split()
    rolewords={"Senior","Systems","Administrator","User","Role","Primary","Phone","Email","Address","Full","Name","System","Username","Last","Login","Passport","Number"}
    if any(w in rolewords for w in words):
        continue
    name_candidates.append(m)
for m in name_candidates:
    candidates.append({"start":m.start(),"end":m.end(),"text":m.group(1),"category":"PII.PERSON_NAME",
                       "classifier_id":"CLS-PII-NAME-001","confidence":0.80,"priority":5})

# Deterministic overlap resolution: start asc, length desc, priority asc, confidence desc; keep non-overlapping
candidates_sorted=sorted(candidates, key=lambda x:(x["start"], -(x["end"]-x["start"]), x["priority"], -x["confidence"]))
selected=[]
for cand in candidates_sorted:
    if any(not(cand["end"]<=s["start"] or cand["start"]>=s["end"]) for s in selected):
        continue
    selected.append(cand)

selected_sorted=sorted(selected, key=lambda x:x["start"])
for s in selected_sorted:
    s["matched_text"]=s.pop("text")

# counts
from collections import Counter
counts=Counter(s["category"] for s in selected_sorted)

result={"total_detections":len(selected_sorted),
        "counts_per_category":dict(counts),
        "spans":[{k:sp[k] for k in ["start","end","matched_text","category","classifier_id","confidence"]} for sp in selected_sorted]}
print(json.dumps(result, indent=2))
