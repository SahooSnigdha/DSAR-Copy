9. Social Security Number: 483-92-1049
10. Health Insurance Number: HI-902849102-B"""

import re
SQUARE = "\u25A0"

def mask_email(s):
    local, dom = s.split("@")
    return SQUARE*len(local) + "@" + dom

def mask_phone(s):
    # preserve +1 and punctuation, mask digits in area/subscriber
    return "+1 (" + SQUARE*3 + ") " + SQUARE*3 + "-" + SQUARE*4

def mask_ssn(s):
    return SQUARE*3 + "-" + SQUARE*2 + "-" + s[-4:]

def mask_iban_like(s):  # not used
    return s

def mask_address(s):
    # mask street number/name + suite, preserve city/state/zip
    return SQUARE*3 + " " + SQUARE*9 + " " + SQUARE*3 + ", " + SQUARE*5 + " " + SQUARE*3 + ", Portland, OR 97201"

def mask_health(s):
    # HI- prefix, -B suffix preserved
    return "HI-" + SQUARE*9 + "-B"

def mask_full(s):
    return "".join(ch if ch==" " else SQUARE for ch in s)

def mask_ip(s):
    return ".".join(SQUARE*len(o) for o in s.split("."))

