# IBAN candidate (variable final group, matches to word end allowing 1-4 tail)
ibanc=re.compile(r'\b[A-Z]{2}\d{2}(?:\s?[A-Z0-9]{4}){2,7}(?:\s?[A-Z0-9]{1,4})?\b')
P("IBAN_candidate_var_tail")
for m in ibanc.finditer(doc1):
    P(f"  [{m.start()},{m.end()}] {m.group(0)!r} endswith23={m.group(0).endswith('23')}")

# ADDRESS rev-001
addr=re.compile(r'\b\d{1,5}\s+[A-Za-z0-9\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\s.,#]+)?(?:,\s+[A-Za-z\s]+,\s+[A-Z]{2}\s+\d{5}(?:-\d{4})?)?\b')
