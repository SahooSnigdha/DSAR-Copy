for m in re.finditer(r"\b(?:Mr|Mrs|Ms|Dr)\.\s+[A-Z][a-z]+(?:\s+[A-Z][a-z]+){0,2}\b", doc):
    ntok = len(m.group(0).replace(".", " ").split()) - 1
    conf = 0.85 if ntok == 1 else 0.95
    ner_raw.append((m.start(), m.end(), m.group(0), conf, "R1"))
