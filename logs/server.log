# INSURANCE substring
P(f"INSURANCE_doc1={[ (m.start(),m.end()) for m in re.finditer('HI-902849102-B',doc1)]}")
P(f"INSURANCE_doc2={[ (m.start(),m.end()) for m in re.finditer('HI-902849102-B',doc2)]}")

# NEGATIVE corpus checks under a candidate USERNAME (label alternation incl 'User')
cand_user=re.compile(r'(?:Username|User\s*Name|User|Login|Account)\s*[:=]?\s*([A-Za-z][A-Za-z0-9._-]*)')
P("NEG_candidate_username_on_UserRole_doc1="+str([(m.start(),m.end(),m.group(0),m.group(1)) for m in cand_user.finditer(doc1) if 'User' in m.group(0)]))
