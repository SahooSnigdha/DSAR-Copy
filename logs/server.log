h in re.finditer(regex, content):\n            if group:\n                match_text = match.group(group)\n                start = match.start(group)\n                end = match.end(group)\n            else:\n                match_text = match.group(0)\n                start = match.start(0)\n                end = match.end(0)\n                \n            all_matches.append({\n                "start": start,\n                "end": end,\n                "matched_text": match_text,\n                "category": category,\n                "classifier_id": f"CLS-{cls_id:03d}",\n                "confidence": confidence,\n                "priority": priority,\n                "location": "content"\n            })\n\n    # Sort matches by start position, then by match length descending, then by priority ascending, then by confidence descending\n    all_matches.sort(key=lambda x: (x["start"], -(x["end"] - x["start"]), x["priority"], -x["confidence"]))\n\n    # Resolve overlaps: greedy keep non-overlapping\n    resolved_matches = []\n    current_end = -1\n\n    for match in all_matches:\n        if match["start"] >= current_end:\n            resolved_matches.append(match)\n            current_end = match["end"]\n\n    return resolved_matches, all_matches\n\n# Find matches and resolve overlaps\nresolved_matches, all_matches = find_and_resolve_overlaps(content, classifiers)\n\n# Count categories\ncategory_counts = {}\nfor match in resolved_matches:\n    category = match["category"]\n    if category not in category_counts:\n        category_counts[category] = 0\n    category_counts[category] += 1\n\n# File name detection and redaction\nfile_name_match = re.search(r"REC-\\d{4}-[A-Za-z0-9_-]+_Transcription\\.pdf", content)\nif file_name_match:\n    file_name = file_name_match.group(0)\n    file_name_span = (file_name_match.start(), file_name_match.end())\n    redacted_file_name = re.sub(r"\\d{4}-", "XXXX-", file_name)  # Mask years\nelse:\n    file_name = "REC-XXXX-_Transcript