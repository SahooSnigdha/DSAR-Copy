    m = re.search(pat, s)
    got = None if not m else (m.group(group) if group is not None else m.group())
    span = None if not m else m.span()
    ok = (m is not None) == expect_match
    if ok and expect_text is not None and m is not None:
        ok = (m.group(0) == expect_text)
    print(f"{name:6} | input={s!r} -> {got!r} span={span} | expect_match={expect_match} expect_text={expect_text!r} | {'PASS' if ok else 'FAIL'}")

