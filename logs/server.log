bruary|March|April|May|June|July|August|September|October|November|December)\\s+(?:0?[1-9]|[12]\\d|3[01]),\\s+(?:19|20)\\d{2}\\b", 0.85, 3),\n    Classifier("CLS-PII-IBAN-001", "PII.FINANCIAL.BANK_ACCOUNT", "regex", r"\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]{4}){3,7}\\b", 0.90, 2),\n    Classifier("CLS-PII-PASSPORT-001", "PII.IDENTIFIER.PASSPORT", "regex", r"\\b[A-Z]\\d{8,9}\\b", 0.85, 3),\n    Classifier("CLS-PII-DL-001", "PII.IDENTIFIER.DRIVERS_LICENSE", "regex", r"\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\b", 0.85, 3),\n    Classifier("CLS-PII-ADDRESS-001", "PII.LOCATION.STREET_ADDRESS", "regex", r"\\b\\d{1,5}\\s+[A-Za-z0-9\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\s.,#]+)?(?:,\\s+[A-Za-z\\s]+,\\s+[A-Z]{2}\\s+\\d{5}(?:-\\d{4})?)?\\b", 0.85, 4),\n    Classifier("CLS-PHI-MED-ID-001", "PHI.MEDICAL_IDENTIFIER", "regex", r"\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\b", 0.90, 2),\n]\n\n# Predefined terms and context for PHI detection\nphi_terms = [\n    "penicillin allergy", "allergy", "Hypertension", "hypertension",\n    "prescription adjustment", "emergency dispensation", "medical dispensation"\n]\n\n# A place to collect candidate detections\nCandidate = namedtuple("Candidate", ["start", "end", "text", "category", "classifier_id", "confidence"])\ncandidates = []\n\n# Function to perform regex-based detection\ndef detect_with_regex(text, classifier):\n    for match in re.finditer(classifier.pattern, text):\n        start, end = match.span()\n        confidence = 0.97 if classifier.classifier_id != "CLS-PII-NAME-001" else 0.85\n        candidates.append(Candidate(start, end, match.group(), classifier.category, classifier.classifier_id, confidence))\n\n# Function to perform name detection\ndef detect_names(text):\n    pattern = re.compile(r"Full Name: ([A-Z][a-z]+ [A-Z][a-z]+(?: [A-Z][a-z]+)?)")\n    for match in pattern.finditer(text):\n        start, end = match.span(1)\n        confidence = 0.97\n        candidates.append(Candidate(start, end, match.group(1), "PII.PERSON_NAME", "CLS-PII-NAME-001", confidence))\n        \n# Function to perform PHI detection using dictionary\ndef detect_phi(text):\n    for term in phi_terms:\n        found = text.lower().find(term.lower())\n        if found != -1:\n            start = found\n            end = start + len(term)\n            confidence = 0.92\n            candidates.append(Candidate(start, end, term, "PHI.HEALTH_DATA", "CLS-PHI-CONDITION-001", confidence))\n\n# Detect using regex classifiers and NER for names\nfor classifier in classifiers:\n    detect_with_regex(DOC, classifier)\n\n# Emulate NER for full names\ndetect_names(DOC)\n\n# Detect PHI terms\ndetect_phi(DOC)\n\n# Sort and resolve overlaps\ncandidates = sorted(candidates, key=lambda x: (x.start, -(x.end - x.start), x.category, -x.confidence))\n\nfiltered_candidates = []\ntaken_ranges = []\n\nfor candidate in candidates:\n    # Check overlap with already taken ranges\n    keep = True\n    for start, end in taken_ranges:\n        if candidate.start < end and start < candidate.end:\n            keep = False\n            break\n    if keep and candidate.confidence >= [cls for cls in classifiers if cls.classifier_id == candidate.classifier_id][0].threshold:\n        filtered_candidates.append(candidate)\n        taken_ranges.append((candidate.start, candidate.end))\n\n# Prepare results\nresults = {\n    "document_length": len(DOC),\n    "detections": [],\n    "total_detections": len(filtered_candidates),\n    "counts_per_category": defaultdict(int)\n}\n\nfor candidate in filtered_candidates:\n    results["detections"].append({\n        "start": candidate.start,\n        "end": candidate.end,\n        "text": candidate.text,\n        "category": candidate.category,\n        "classifier_id": candidate.classifier_id,\n        "confidence": candidate.confidence,\n        "mask_token": "*" * len(candidate.text)\n    })\n    results["counts_per_category"][candidate.category] += 1\n\n# Output th