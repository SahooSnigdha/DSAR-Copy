ADDR = r'\b\d{1,5}[ \t]+(?:[A-Za-z0-9][A-Za-z0-9.\-#]*[ \t]+){0,6}(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)\b(?:[ \t]*,[ \t]*(?:Suite|Ste|Unit|Apt|Bldg|Floor|Fl)[ \t]*#?[0-9A-Za-z-]+|[ \t]+(?:Suite|Ste|Unit|Apt|Bldg|Floor|Fl)[ \t]*#?[0-9A-Za-z-]+)?(?:,[ \t]+[A-Za-z .]+,[ \t]+[A-Z]{2}[ \t]+\d{5}(?:-\d{4})?)?'
