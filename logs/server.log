   "classifier_id": "CLS-PHI-CONDITION-001", "confidence": condition_thr, "priority": condition_priority})\n\n# NER person approximation (deterministic)\nname_candidates = []\n\nfor m in re.finditer(r"\\b([A-Z][a-z]+(?:\\s+[A-Z][a-z]+){1,3})\\b", text):\n    span_start = m.start()\n    # Find field label preceding on the same line\n    line_start = text.rfind("\\n", 0, span_start) + 1\n    label = text[line_start:span_start]\n    # Role exclusion\n    if "User Role" in label:\n        continue\n    # Crude role-word exclusion\n    words = m.group(1).split()\n    role_words = {"Senior", "Systems", "Administrator", "User", "Role", "Primary", "Phone", "Email", "Address", "Full",\n                  "Name", "System", "Username", "Last", "Login", "Passport", "Number"}\n    if any(w in role_words for w in words):\n        continue\n    name_candidates.append(m)\n\nfor m in name_candidates:\n    candidates.append({"start": m.start(), "end": m.end(), "text": m.group(1), "category": "PII.PERSON_NAME",\n                       "classifier_id": "CLS-PII-NAME-001", "confidence": 0.80, "priority": 5})\n\n# Deterministic overlap resolution\ncandidates_sorted = sorted(candidates, key=lambda x: (x["start"], -(x["end"] - x["start"]), x["priority"], -x["confidence"]))\nselected = []\n\nfor cand in candidates_sorted:\n    if any(not (cand["end"] <= s["start"] or cand["start"] >= s["end"]) for s in selected):\n        continue\n    selected.append(cand)\n\nselected_sorted = sorted(selected, key=lambda x: x["start"])\nfor s in selected_sorted:\n    s["matched_text"] = s.pop("text")\n\n# Counts\ncounts = Counter(s["category"] for s in selected_sorted)\n\nresult = {\n    "total_detections": len(selected_sorted),\n    "counts_per_category": dict(counts),\n    "spans": [{k: sp[k] for k in ["start", "end", "matched_text", "category", "classifier_id", "confidence"]} for sp in selected_sorted]\n}\n\njson.dumps(result, indent=2)'}, 'extras': {'container_id': 'cntr_6ad5fa0c25088191929b1e0548611f73