 {"classifier_id":"CLS-PII-EMAIL-001","category":"PII.CONTACT.EMAIL","type":"regex","priority":2,"threshold":0.95,"conf":0.99,
  "pattern":r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"},
 {"classifier_id":"CLS-PII-PHONE-001","category":"PII.CONTACT.PHONE_NUMBER","type":"regex","priority":2,"threshold":0.90,"conf":0.97,
  "pattern":r"(?:\+?1[-. ]?)?(?:\(\d{3}\)|\b\d{3})[-. ]?\d{3}[-. ]?\d{4}\b"},
 {"classifier_id":"CLS-PII-IP-001","category":"PII.LOCATION.IP_ADDRESS","type":"regex","priority":3,"threshold":0.90,"conf":0.98,
  "pattern":r"\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b|\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\b"},
