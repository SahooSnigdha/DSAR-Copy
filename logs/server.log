doc1="\n".join(lines1)

addr=re.compile(r'\b\d{1,5}\s+[A-Za-z0-9\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\s.,#]+)?(?:,\s+[A-Za-z\s]+,\s+[A-Z]{2}\s+\d{5}(?:-\d{4})?)?\b')
iban=re.compile(r'\b[A-Z]{2}\d{2}(?:\s?[A-Z0-9]{4}){3,7}\b')
ccrev1=re.compile(r'\b(?:4\d{3}|5[1-5]\d{2}|6011|3[47]\d{2})[- ]?\d{4}[- ]?\d{4}[- ]?\d{4}\b|\b\d{4}-\d{4}-\d{4}-\d{4}\b')
# line-anchored candidate address (must not cross newline)
addr_line=re.compile(r'\b\d{1,5}[ \t]+[A-Za-z0-9 \t.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9 \t.,#]+)?(?:, +[A-Za-z ]+, +[A-Z]{2} +\d{5}(?:-\d{4})?)?')
out=[]
for tag,rx in [("ADDRESS_rev001",addr),("ADDRESS_lineanchored",addr_line),("IBAN_rev001",iban),("CC_rev001_literal",ccrev1)]:
    ms=list(rx.finditer(doc1))
