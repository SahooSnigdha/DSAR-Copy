emitted.sort(key=lambda c: (c["start"], -(c["end"]-c["start"]), c["priority"], -c["confidence"]))
kept, dropped_overlap = [], 0
for c in emitted:
    if all(c["end"] <= k["start"] or c["start"] >= k["end"] for k in kept):
