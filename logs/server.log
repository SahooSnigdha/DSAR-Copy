4. Primary Phone: +1 (555) 712-4091
5. User Role: Senior Systems Administrator
6. Passport Number: N89201492
7. Last Login IP: 192.168.10.45
8. Residential Address: 100 Cyberdyne Way, Suite 400, Portland, OR 97201
9. Social Security Number: 483-92-1049
10. Health Insurance Number: HI-902849102-B"""

filename = "Marcus Vance System Account Record.pdf"

candidates = []

def add_span(start, end, matched, category, classifier_id, confidence, location="content", priority=99):
    candidates.append({
        "start": start,
        "end": end,
        "matched_text": matched,
        "category": category,
        "classifier_id": classifier_id,
        "confidence": confidence,
        "location": location,
        "priority": priority,
    })

# CLS-PII-SSN-001
for m in re.finditer(r"\b\d{3}-\d{2}-\d{4}\b", doc_text):
    add_span(m.start(), m.end(), m.group(0), "PII.IDENTIFIER.SSN", "CLS-PII-SSN-001", 0.95, priority=1)

# CLS-PII-EMAIL-001
for m in re.finditer(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b", doc_text):
    add_span(m.start(), m.end(), m.group(0), "PII.CONTACT.EMAIL", "CLS-PII-EMAIL-001", 0.95, priority=2)

# CLS-PII-PHONE-001
for m in re.finditer(r"(?:\+?1[-. ]?)?(?:\(\d{3}\)|\b\d{3})[-. ]?\d{3}[-. ]?\d{4}\b", doc_text):
    add_span(m.start(), m.end(), m.group(0), "PII.CONTACT.PHONE_NUMBER", "CLS-PII-PHONE-001", 0.90, priority=2)

# CLS-PII-IP-001
for m in re.finditer(r"\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b|\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\b", doc_text):
    add_span(m.start(), m.end(), m.group(0), "PII.LOCATION.IP_ADDRESS", "CLS-PII-IP-001", 0.90, priority=3)

# CLS-PII-PASSPORT-001
for m in re.finditer(r"\b[A-Z]\d{8,9}\b", doc_text):
    add_span(m.start(), m.end(), m.group(0), "PII.IDENTIFIER.PASSPORT", "CLS-PII-PASSPORT-001", 0.85, priority=3)

# CLS-PII-ADDRESS-001
addr_pat = r"\b\d{1,5}[ \t]+[A-Za-z0-9., \t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \t]+(?:Suite|Ste|Apt|Unit|#)[ \t]+[A-Za-z0-9-]+)?,[ \t]+[A-Za-z \t]+,[ \t]+[A-Z]{2}[ \t]+\d{5}(?:-\d{4})?\b|\b\d{1,5}[ \t]+[A-Za-z0-9., \t]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:,?[ \t]+(?:Suite|Ste|Apt|Unit|#)[ \t]+[A-Za-z0-9-]+)?\b"
for m in re.finditer(addr_pat, doc_text):
    add_span(m.start(), m.end(), m.group(0), "PII.LOCATION.STREET_ADDRESS", "CLS-PII-ADDRESS-001", 0.85, priority=4)

# CLS-PII-NAME-001: deterministic PERSON span from explicit Full Name label (NER substitute)
for m in re.finditer(r"(?i:Full Name:[ \t]*)([A-Z][A-Za-z.'-]+(?:\s+[A-Z][A-Za-z.'-]+){1,3})\b", doc_text):
    add_span(m.start(1), m.end(1), m.group(1), "PII.PERSON_NAME", "CLS-PII-NAME-001", 0.80, priority=5)

# CLS-PII-USERNAME-001: capture group only
for m in re.finditer(r"(?i:\b(?:Account Name|Username|User Name|Login|Account):[ \t]*)(?!Role\b)([a-zA-Z][a-zA-Z0-9._-]{2,30})\b", doc_text):
    add_span(m.start(1), m.end(1), m.group(1), "PII.IDENTIFIER.USERNAME", "CLS-PII-USERNAME-001", 0.86, priority=3)

# CLS-PHI-INSURANCE-MEMBER-ID-001
for m in re.finditer(r"\b(?:HI|INS|POL|GRP)-[A-Za-z0-9-]{6,16}\b|(?i:\bHealth Insurance (?:Number|ID|Member ID):[ \t]*)([A-Za-z0-9-]+)\b", doc_text):
    matched = m.group(0)
    start, end = m.start(), m.end()
    # If second alternative captured a value, report the value only
    if m.lastindex and m.group(m.lastindex):
        start, end = m.start(m.lastindex), m.end(m.lastindex)
        matched = m.group(m.lastindex)
    add_span(start, end, matched, "PHI.MEDICAL_IDENTIFIER.HEALTH_INSURANCE_MEMBER_ID", "CLS-PHI-INSURANCE-MEMBER-ID-001", 0.90, priority=2)

# Resolve content overlaps
content = [c for c in candidates if c["location"] == "content"]
content.sort(key=lambda x: (x["start"], -(x["end"]-x["start"]), x["priority"], -x["confidence"], x["classifier_id"]))
resolved = []
occupied = []
for c in content:
    if any(not (c["end"] <= s or c["start"] >= e) for s, e in occupied):
        continue
    resolved.append(c)
    occupied.append((c["start"], c["end"]))

# Filename scanning: detect person-name entity from content that also appears in filename
fname_candidates = []
# Check longest contiguous token subsequences of the detected content person name that appear in filename
person_spans = [c for c in resolved if c["category"] == "PII.PERSON_NAME"]
for ps in person_spans:
    tokens = ps["matched_text"].split()
    # longest subphrase, then shorter
    for n in range(len(tokens), 0, -1):
        found = False
        for i in range(0, len(tokens)-n+1):
            phrase = " ".join(tokens[i:i+n])
            pos = filename.find(phrase)
            if pos != -1:
                fname_candidates.append({
                    "start": pos,
                    "end": pos + len(phrase),
                    "matched_text": phrase,
                    "category": "PII.PERSON_NAME",
                    "classifier_id": "CLS-PII-NAME-001",
                    "confidence": 0.80,
                    "location": "file_name",
                    "priority": 5,
                })
                found = True
                break
        if found:
            break
# Resolve filename overlaps
fname_candidates.sort(key=lambda x: (x["start"], -(x["end"]-x["start"]), x["priority"], -x["confidence"]))
fname_resolved = []
foccupied = []
for c in fname_candidates:
    if any(not (c["end"] <= s or c["start"] >= e) for s, e in foccupied):
        continue
    fname_resolved.append(c)
    foccupied.append((c["start"], c["end"]))

all_spans = sorted(resolved + fname_resolved, key=lambda x: (0 if x["location"]=="content" else 1, x["start"]))
# Format output without internal priority field
out_spans = []
for c in all_spans:
    out_spans.append({
        "start": c["start"],
        "end": c["end"],
        "matched_text": c["matched_text"],
        "category": c["category"],
        "classifier_id": c["classifier_id"],
        "confidence": c["confidence"],
        "location": c["location"],
    })

metadata = {
    "ruleset_revision": "rev-002",
    "ruleset_version": "1.1.0",
    "total_detections": len(out_spans),
    "content_detections": len(resolved),
    "file_name_detections": len(fname_resolved),
    "counts_per_category": dict(Counter([s["category"] for s in out_spans])),
    "counts_per_location": dict(Counter([s["location"] for s in out_spans])),
    "proposed_filename_mask": "XXXXXX XXXXX System Account Record_redacted.pdf",
}

print(json.dumps({"spans": out_spans, "metadata": metadata}, indent=2))
