CLS-PII-ADDRESS-001, PII.LOCATION.STREET_ADDRESS, regex, r"\b\d{1,5}\s+[A-Za-z0-9\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\s.,#]+)?(?:,\s+[A-Za-z\s]+,\s+[A-Z]{2}\s+\d{5}(?:-\d{4})?)?\b", 0.85, 4
CLS-PHI-MED-ID-001, PHI.MEDICAL_IDENTIFIER, regex, r"\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\b", 0.90, 2

