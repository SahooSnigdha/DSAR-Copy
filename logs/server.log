    nm = re.match(r"([A-Z][a-zA-Z'\-]+(?:\s+[A-Z][a-zA-Z'\-]+){0,4})", remainder)
    if nm:
        s = m.end()+nm.start(1); e = m.end()+nm.end(1)
        cands.append(dict(start=s,end=e,text=TEXT[s:e],category="PII.PERSON_NAME",
            classifier_id="CLS-PII-NAME-001",confidence=0.80,priority=5,_order=3,type="ner(PERSON)"))

# ---- confidence threshold gate (per-classifier thresholds as pinned) ----
THRESH = {"CLS-PII-SSN-001":0.95,"CLS-PII-CC-001":0.95,"CLS-PII-EMAIL-001":0.95,
 "CLS-PII-PHONE-001":0.90,"CLS-PII-IP-001":0.90,"CLS-PII-DOB-001":0.85,
 "CLS-PII-IBAN-001":0.90,"CLS-PII-PASSPORT-001":0.85,"CLS-PII-DL-001":0.85,
 "CLS-PII-ADDRESS-001":0.85,"CLS-PII-NAME-001":0.80,"CLS-PHI-MED-ID-001":0.90,
 "CLS-PHI-CONDITION-001":0.85}
cands = [c for c in cands if c["confidence"] >= THRESH[c["classifier_id"]]]

# ---- contextual classification ----
notes = []
for c in cands:
    win = TEXT[max(0,c["start"]-60):c["start"]]
    low = win.lower()
    if c["classifier_id"]=="CLS-PII-DOB-001":
        if re.search(r"(date of birth|dob|born)", low): notes.append(("DOB_CONFIRMED",c["text"]))
        else: c["context"]="NO_DOB_CONTEXT"; notes.append(("DOB_NO_CONTEXT_MATCH",c["text"]))
    if c["classifier_id"]=="CLS-PHI-MED-ID-001":
        c["context"] = "PATIENT_MEDICAL_REFERENCE" if re.search(r"(patient|member|medical|case)", low) else "GENERAL_LOG_RECORD_IDENTIFIER"

# ---- deterministic resolution ----
def sortkey(c): return (c["start"], -(c["end"]-c["start"]), c["priority"], -c["confidence"])
resolved=[]
for c in sorted(cands,key=sortkey):
    if all(c["end"]<=r["start"] or c["start"]>=r["end"] for r in resolved):
        resolved.append(c)
resolved.sort(key=lambda c:c["start"])

out=[]
for c in resolved:
    out.append({k:c[k] for k in ["start","end","text","category","classifier_id","confidence"]**0} |
