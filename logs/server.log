{"message": "Query: import re, json

TEXT = """================================================================
================
SYNTHETIC PII TEST RECORD - FOR PIPELINE VALIDATION ONLY
================================================================
================
1. Full Name: Jonathan Edward Doe
2. Social Security Number: 900-88-2041
3. Credit Card Number: 4111-2222-3333-4444
4. Email Address: j.doe.secure_test@example-domain.org
5. Phone Number: +1 (555) 019-8472
Address: 1042 Hidden Valley Road, Seattle, WA 98101
================================================================
================"""

# ---- pinned ruleset rev-001 (verbatim patterns) ----
REGEX_CLASSIFIERS = [
 ("CLS-PII-SSN-001","PII.IDENTIFIER.SSN",0.95,1,1,
  r"\b\d{3}-\d{2}-\d{4}\b","[SSN]"),
 ("CLS-PII-CC-001","PII.FINANCIAL.CREDIT_CARD",0.95,1,1,
  r"\b(?:4\d{3}|5[1-5]\d{2}|6011|3[47]\d{2})[- ]?\d{4}[- ]?\d{4}[- ]?\d{4}\b|\b\d{4}-\d{4}-\d{4}-\d{4}\b","[CREDIT_CARD]"),
 ("CLS-PII-EMAIL-001","PII.CONTACT.EMAIL",0.95,2,1,
  r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b","[EMAIL]"),
 ("CLS-PII-PHONE-001","PII.CONTACT.PHONE_NUMBER",0.90,2,1,
  r"(?:\+?1[-. ]?)?(?:\(\d{3}\)|\b\d{3})[-. ]?\d{3}[-. ]?\d{4}\b","[PHONE_NUMBER]"),
 ("CLS-PII-IP-001","PII.LOCATION.IP_ADDRESS",0.90,3,1,
  r"\b(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b|\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\b","[IP_ADDRESS]"),
 ("CLS-PII-DOB-001","PII.DEMOGRAPHIC.DATE_OF_BIRTH",0.85,3,1,
  r"\b(?:19|20)\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\d|3[01])\b|\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\s+(?:0?[1-9]|[12]\d|3[01]),\s+(?:19|20)\d{2}\b","[DATE_OF_BIRTH]"),
 ("CLS-PII-IBAN-001","PII.FINANCIAL.BANK_ACCOUNT",0.90,2,1,
  r"\b[A-Z]{2}\d{2}(?:\s?[A-Z0-9]{4}){3,7}\b","[BANK_ACCOUNT]"),
 ("CLS-PII-PASSPORT-001","PII.IDENTIFIER.PASSPORT",0.85,3,1,
  r"\b[A-Z]\d{8,9}\b","[PASSPORT]"),
 ("CLS-PII-DL-001","PII.IDENTIFIER.DRIVERS_LICENSE",0.85,3,1,
  r"\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\b","[DRIVERS_LICENSE]"),
 ("CLS-PII-ADDRESS-001","PII.LOCATION.STREET_ADDRESS",0.85,4,1,
  r"\b\d{1,5}\s+[A-Za-z0-9\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\s.,#]+)?(?:,\s+[A-Za-z\s]+,\s+[A-Z]{2}\s+\d{5}(?:-\d{4})?)?\b","[STREET_ADDRESS]"),
 ("CLS-PHI-MED-ID-001","PHI.MEDICAL_IDENTIFIER",0.90,2,1,
  r"\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\b","[MEDICAL_ID]"),
]

DICT_TERMS = ["penicillin allergy","allergy","Hypertension","hypertension",
              "prescription adjustment","emergency dispensation","medical dispensation"]
DICT_CLS = ("CLS-PHI-CONDITION-001","PHI.HEALTH_DATA",0.85,3)

cands = []
for cid,cat,conf,prio,order,pat,mask in REGEX_CLASSIFIERS:
    for m in re.finditer(pat, TEXT):
        if m.group(0).strip()=="": continue
        cands.append(dict(start=m.start(),end=m.end(),text=m.group(0),
                          category=cat,classifier_id=cid,confidence=conf,priority=prio,
                          _order=order,type="regex"))

# dictionary/heuristic classifier
for t in DICT_TERMS:
    for m in re.finditer(re.escape(t), TEXT, flags=re.IGNORECASE if t.lower()==t and t.islower() else 0):
        if t[0].isupper():  # case-sensitive terms only
            for mm in re.finditer(re.escape(t), TEXT):
                cands.append(dict(start=mm.start(),end=mm.end(),text=mm.group(0),
                    category=DICT_CLS[1],classifier_id=DICT_CLS[0],confidence=DICT_CLS[2],
                    priority=DICT_CLS[3],_order=2,type="dictionary"))
        else:
            cands.append(dict(start=m.start(),end=m.end(),text=m.group(0),
                category=DICT_CLS[1],classifier_id=DICT_CLS[0],confidence=DICT_CLS[2],
                priority=DICT_CLS[3],_order=2,type="dictionary"))

# ---- NER PERSON classifier (CLS-PII-NAME-001) ----
# deterministic emulation: label-anchored + capitalized-token-sequence heuristic
NAME_LABELS = r"(?:Full Name|Name|Patient Name|Contact Name)\s*:\s*"
for m in re.finditer(NAME_LABELS, TEXT, flags=re.IGNORECASE):
