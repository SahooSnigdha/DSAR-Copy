-z0-9\\s.,#]+)?(?:,\\s+[A-Za-z\\s]+,\\s+[A-Z]{2}\\s+\\d{5}(?:-\\d{4})?)?\\b"},\r\n    {"classifier_id": "CLS-PHI-MED-ID-001", "category": "PHI.MEDICAL_IDENTIFIER", "type": "regex", "priority": 2,\r\n     "threshold": 0.90, "conf": 0.95, "pattern": r"\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\b"},\r\n    {"classifier_id": "CLS-PHI-CONDITION-001", "category": "PHI.HEALTH_DATA", "type": "dictionary_and_heuristic",\r\n     "priority": 3, "threshold": 0.85, "conf": 0.90,\r\n     "terms": ["penicillin allergy", "allergy", "Hypertension", "hypertension", "prescription adjustment",\r\n               "emergency dispensation", "medical dispensation"]},\r\n    {"classifier_id": "CLS-PII-NAME-001", "category": "PII.PERSON_NAME", "type": "ner", "entity_types": ["PERSON"],\r\n     "priority": 5, "threshold": 0.80, "conf": 0.95},\r\n]\r\n\r\ndef line_of(pos):\r\n    return DOC.count("\\n", 0, pos) + 1\r\n\r\ncandidates = []\r\nraw_counts = {}\r\n\r\n# --- Regex classifiers ---\r\nfor cl in CLS:\r\n    if cl["type"] != "regex":\r\n        continue\r\n    rx = re.compile(cl["pattern"])\r\n    ms = list(rx.finditer(DOC))\r\n    raw_counts[cl["classifier_id"]] = len(ms)\r\n    for m in ms:\r\n        candidates.append({"start": m.start(), "end": m.end(), "matched_text": m.group(0),\r\n                           "category": cl["category"], "classifier_id": cl["classifier_id"],\r\n                           "confidence": cl["conf"], "threshold": cl["threshold"],\r\n                           "priority": cl["priority"], "line": line_of(m.start())})\r\n\r\n# --- Dictionary classifier (case-sensitive per pinned term list) ---\r\ndict_cl = next(c for c in CLS if c["classifier_id"] == "CLS-PHI-CONDITION-001")\r\ndcount = 0\r\nfor t in dict_cl["terms"]:\r\n    idx = 0\r\n    while True:\r\n        i = DOC.find(t, idx)\r\n        if i == -1: break\r\n        candidates.append({"start": i, "end": i+len(t), "matched_text": t, "category": dict_cl["category"],\r\n                           "classifier_id": dict_cl["classifier_id"], "confidence": dict_cl["conf"],\r\n                           "threshold": dict_cl["threshold"], "priority": dict_cl["priority"], "line": line_of(i)})\r\n        dcount += 1\r\n        idx = i + len(t)\r\nraw_counts["CLS-PHI-CONDITION-001"] = dcount\r\n\r\n# --- NER classifier CLS-PII-NAME-001 (PERSON) ---\r\nner_method = "deterministic_labeled_field_extraction (no NER model runtime available in execution environment)"\r\nnm = re.search(r"^Full Name: (.+)$", DOC, re.M)\r\nif nm:\r\n    candidates.append({"start": nm.start(1), "end": nm.end(1), "matched_text": nm.group(1),\r\n                       "category": "PII.PERSON_NAME", "classifier_id": "CLS-PII-NAME-001",\r\n                       "confidence": 0.95, "threshold": 0.80, "priority": 5, "line": line_of(nm.start(1))})\r\n    raw_counts["CLS-PII-NAME-001"] = 1\r\nelse:\r\n    raw_counts["CLS-PII-NAME-001"] = 0\r\n\r\n# --- Contextual classification: DOB vs transaction timestamp ---\r\nBIRTH_CUES = ["date of birth", "dob", "born", "birth date", "d.o.b"]\r\nts_pos = DOC.find("Transaction Summary")\r\nemitted, suppressed = [], []\r\nfor c in candidates:\r\n    if c["classifier_id"] == "CLS-PII-DOB-001":\r\n        ln_start = DOC.rfind("\\n", 0, c["start"]) + 1\r\n        ln_end = DOC.find("\\n", c["end"]);  ln_end = len(DOC) if ln_end == -1 else ln_end\r\n        line_txt = DOC[ln_start:ln_end].lower()\r\n        ctx = DOC[max(0, c["start"]-200):c["end"]+50].lower()\r\n        has_birth_cue = any(k in line_txt or k in ctx for k in BIRTH_CUES)\r\n        in_txn_section = c["start"] > ts_pos\r\n        if (not has_birth_cue) and in_txn_section:\r\n            suppressed.append({k: c[k] for k in ("start","end","matched_text","classifier_id","line")})\r\n            suppressed[-1]["reason"] = "transaction_timestamp_context (Transaction Summary table row; no birth-context cues anywhere in document) - not DATE_OF_BIRTH"\r\n            continue\r\n    emitted.append(c)\r\n\r\n# --- Determ