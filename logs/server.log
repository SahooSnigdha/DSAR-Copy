if m1: canon.append(m1.group(1))
m2 = re.search(r"Emergency contact is\s+([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)", doc)
if m2: canon.append(m2.group(1))
print("CANON_NAMES", canon)
titles = {"Mr","Mrs","Ms","Dr"}
firsts, lasts = set(), set()
for name in canon:
    parts = [p for p in name.replace(".", " ").split() if p and p not in titles]
    if parts:
        firsts.add(parts[0]); lasts.add(parts[-1])
print("LEXICON firsts=", sorted(firsts), "lasts=", sorted(lasts))

ner_raw = []
