spans = [(14,35,"Marcus Aurelius Vance"),(88,118,"m.vance@vanceresearch-labs.org"),(137,154,"+1 (555) 712-4091"),(218,227,"N89201492"),(246,259,"192.168.10.45")]

# Verify offsets match exactly
for s,e,t in spans:
    actual = source_text[s:e]
    print(f"offset {s}-{e}: expected={t!r} actual={actual!r} match={actual==t}")

# Build masked text via char-for-char black squares
masked = list(source_text)
for s,e,t in spans:
    for i in range(s,e):
        masked[i] = "\u25A0"
masked_text = "".join(masked)
print("---- MASKED ----")
