    ("192.168.10.45", mask_ip("192.168.10.45")),
    ("100 Cyberdyne Way, Suite 400, Portland, OR 97201", mask_address("100 Cyberdyne Way, Suite 400, Portland, OR 97201")),
    ("483-92-1049", mask_ssn("483-92-1049")),
    ("HI-902849102-B", mask_health("HI-902849102-B")),
]
for a,b in repls:
    out = out.replace(a,b)

print(out)
print("----- LEAKAGE CHECK -----")
# Sensitive substrings that must NOT survive unmasked
sensitive = ["Marcus","Aurelius","Vance","mavance","m.vance","gmail","555","712","4091",
             "N89201492","89201492","192.168","10.45","Cyberdyne","Suite","483","92-1049",
