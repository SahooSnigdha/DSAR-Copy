"Email Address: m.vance@vanceresearch-labs.org","Primary Phone: +1 (555) 712-4091","User Role: Senior Systems Administrator",
"Passport Number: N89201492","Last Login IP: 192.168.10.45","Residential Address: 100 Cyberdyne Way, Suite 400, Portland, OR 97201",
"Social Security Number: 483-92-1049","Health Insurance Number: HI-902849102-B","Bank Account (IBAN): US39 OBAK 0123 4567 8901 23",
"Transaction Summary","Date Type Amount Method","2026-08-15 Monthly ","Subscription","$49.99 Visa Card 4532-","8910-4321-9081",
"2026-09-02 Inbound Transfer $2,500.00 Bank Transfer US39 ","OBAK","2026-09-18 Equipment ","Purchase","$320.50 Visa Card 4532-",
"8910-4321-9081","2026-10-10 Outbound Transfer $1,250.00 Visa Card 4532-","8910-4321-9081"]
lines2=["1. Full Name: Marcus Aurelius Vance","2. System Username: mavance_admin","3. Email Address: m.vance@gmail.com",
"4. Primary Phone: +1 (555) 712-4091","5. User Role: Senior Systems Administrator","6. Passport Number: N89201492",
"7. Last Login IP: 192.168.10.45","8. Residential Address: 100 Cyberdyne Way, Suite 400, Portland, OR 97201",
"9. Social Security Number: 483-92-1049","10. Health Insurance Number: HI-902849102-B"]
doc1="\n".join(lines1); doc2="\n".join(lines2)
def luhn(d):
    s=0;alt=False
    for c in reversed(d):
        x=int(c)
        if alt:
            x*=2; x-= 9 if x>9 else 0
        s+=x; alt=not alt
    return s%10==0
buf=[]
P=lambda s: buf.append(str(s))

# CC scanner
cc=re.compile(r'\b(?:4\d{3}|5[1-5]\d{2}|6011|3[47]\d{2})([\s\-]+)\d{4}([\s\-]+)\d{4}([\s\-]+)\d{4}\b')
def clA(s): return "HYPHEN" if "-" in s else "SPACE"
def clB(s):
    if s=="-\n" or ("\n" in s and "-" in s): return "NEWLINE_BEARING"
    if "-" in s: return "HYPHEN"
    return "SPACE"
P("CC_VARIANT_A")
for m in cc.finditer(doc1):
    t=m.group(0); seps=[m.group(1),m.group(2),m.group(3)]; cls=[clA(s) for s in seps]; dg=re.sub(r'\D','',t)
    P(f"  [{m.start()},{m.end()}] text={t!r} seps={[repr(s) for s in seps]} classes={cls} uniform={len(set(cls))==1} digits={dg} luhn={luhn(dg)}")
P("CC_VARIANT_B")
for m in cc.finditer(doc1):
    t=m.group(0); seps=[m.group(1),m.group(2),m.group(3)]; cls=[clB(s) for s in seps]; dg=re.sub(r'\D','',t)
    P(f"  [{m.start()},{m.end()}] text={t!r} seps={[repr(s) for s in seps]} classes={cls} uniform={len(set(cls))==1} digits={dg} luhn={luhn(dg)}")

# IBAN rev-001 exact
iban=re.compile(r'\b[A-Z]{2}\d{2}(?:\s?[A-Z0-9]{4}){3,7}\b')
P("IBAN_rev001")
for m in iban.finditer(doc1):
