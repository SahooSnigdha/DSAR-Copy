 {"classifier_id":"CLS-PII-IBAN-001","category":"PII.FINANCIAL.BANK_ACCOUNT","type":"regex","priority":2,"threshold":0.90,"conf":0.96,
  "pattern":r"\b[A-Z]{2}\d{2}(?:\s?[A-Z0-9]{4}){3,7}\b"},
 {"classifier_id":"CLS-PII-PASSPORT-001","category":"PII.IDENTIFIER.PASSPORT","type":"regex","priority":3,"threshold":0.85,"conf":0.95,
