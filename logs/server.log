{"message": "Query: Validate redaction spans against source text and apply masking.

source_text = "================================================================\n================\nSYNTHETIC PII TEST RECORD - FOR PIPELINE VALIDATION ONLY\n================================================================\n================\n1. Full Name: Jonathan Edward Doe\n2. Social Security Number: 900-88-2041\n3. Credit Card Number: 4111-2222-3333-4444\n4. Email Address: j.doe.secure_test@example-domain.org\n5. Phone Number: +1 (555) 019-8472\nAddress: 1042 Hidden Valley Road, Seattle, WA 98101\n================================================================\n================"

approved = [
 (235,254,"Jonathan Edward Doe"),
 (282,293,"900-88-2041"),
 (317,336,"4111-2222-3333-4444"),
 (355,391,"j.doe.secure_test@example-domain.org"),
 (409,426,"+1 (555) 019-8472"),
 (436,478,"1042 Hidden Valley Road, Seattle, WA 98101"),
]

print("len(source_text) =", len(source_text))
print("---- offset validation ----")
ok = True
for s,e,t in approved:
    actual = source_text[s:e]
    match = (actual == t)
    ok &= match
    print(f"[{s}:{e}] expected={t!r} actual={actual!r} len={len(actual)} match={match}")
print("ALL SPANS VALID:", ok)

# also show contexts / check for duplicate occurrences of each string in doc
print("\n---- occurrence counts ----")
for s,e,t in approved:
    print(t, "->", source_text.count(t))

print("\n---- non-overlap check ----")
spans = sorted([(s,e) for s,e,_ in approved])
print(spans)
print("overlaps:", any(spans[i][1] > spans[i+1][0] for i in range(len(spans)-1)))

# apply masking
masked = source_text
for s,e,t in sorted(approved, key=lambda x: -x[0]):
    masked = masked[:s] + "\u25a0"*len(t) + masked[e:]
print("\n---- MASKED OUTPUT ----")
print(masked)
print("\nlen(masked) =", len(masked), "len(source) =", len(source_text))
