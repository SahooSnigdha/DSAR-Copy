\n8910-4321-9081\',\n    \'Account mavance_admin\'\n]\n\n# Function to process negative strings\ndef check_negative_strings(test_strings):\n    results = []\n    for s in test_strings:\n        # Check each pattern\n        for pattern_info in [\n            (CC_RE, \'CC\', None), \n            (IBAN_RE, \'IBAN\', lambda t: 10 <= len(re.sub(r\'\\s|\\t|\\n\', \'\', t)) <= 34), \n            (ADDRESS_RE, \'ADDRESS\', lambda t: (t.index(\'\\n\') if \'\\n\' in t else len(t))),\n            (USERNAME_RE, \'USERNAME\', lambda t: len(t) > 0),\n            (INSURANCE_RE, \'INSURANCE\', lambda t: True)]: \n\n            pattern, class_name, postfilter = pattern_info\n            for match in re.finditer(pattern, s):\n                start, end = match.span(1 if class_name == \'USERNAME\' else 0)\n                text = match.group(1 if class_name == \'USERNAME\' else 0)\n                \n                # Apply postfilter if any\n                if postfilter:\n                    if class_name == \'IBAN\':\n                        text_cleaned = re.sub(r\'\\s|\\t|\\n\', \'\', text)\n                        if not postfilter(text_cleaned):\n                            continue  # Skip non-matching IBAN\n                    elif class_name == \'ADDRESS\':\n                        end = postfilter(text)  # Adjust end for ADDRESS\n                        text = text[:end]\n                \n                results.append({\n                    \'span\': (start, end),\n                    \'text\': text,\n                    \'class\': class_name\n                })\n\n    return results\n\nnegative_results = check_negative_strings(negative_test_strings)\n\ncc_results, negative_results'}, 'extras': {'container_id': 'cntr_6ad602dc7a888191b580413f3717695803e2308fed53c7d9'}}, {'type': 'server_tool_result', 'tool_call_id': 'ci_05bf7ff7277afea8006ad602dd175487d28db288ec717f09a6', 'status': 'success'}, {'type': 'text', 'text': "### CC Test Strings Results:\n\n- **String**: `'4532-\\n