b|\\\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\\\b", thr=0.90, pri=3, mask="[IP_ADDRESS]"),\\n dict(id="CLS-PII-DOB-001", cat="PII.DEMOGRAPHIC.DATE_OF_BIRTH", pat=r"\\\\b(?:19|20)\\\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])\\\\b|\\\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\\\s+(?:0?[1-9]|[12]\\\\d|3[01]),\\\\s+(?:19|20)\\\\d{2}\\\\b", thr=0.85, pri=3, mask="[DATE_OF_BIRTH]"),\\n dict(id="CLS-PII-IBAN-001", cat="PII.FINANCIAL.BANK_ACCOUNT", pat=r"\\\\b[A-Z]{2}\\\\d{2}(?:\\\\s?[A-Z0-9]{4}){3,7}\\\\b", thr=0.90, pri=2, mask="[BANK_ACCOUNT]"),\\n dict(id="CLS-PII-PASSPORT-001", cat="PII.IDENTIFIER.PASSPORT", pat=r"\\\\b[A-Z]\\\\d{8,9}\\\\b", thr=0.85, pri=3, mask="[PASSPORT]"),\\n dict(id="CLS-PII-DL-001", cat="PII.IDENTIFIER.DRIVERS_LICENSE", pat=r"\\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b", thr=0.85, pri=3, mask="[DRIVERS_LICENSE]"),\\n dict(id="CLS-PII-ADDRESS-001", cat="PII.LOCATION.STREET_ADDRESS", pat=r"\\\\b\\\\d{1,5}\\\\s+[A-Za-z0-9\\\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\\\s.,#]+)?(?:,\\\\s+[A-Za-z\\\\s]+,\\\\s+[A-Z]{2}\\\\s+\\\\d{5}(?:-\\\\d{4})?)?\\\\b", thr=0.85, pri=4, mask="[STREET_ADDRESS]"),\\n dict(id="CLS-PHI-MED-ID-001", cat="PHI.MEDICAL_IDENTIFIER", pat=r"\\\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\\\b", thr=0.90, pri=2, mask="[MEDICAL_ID]"),\\n]\\n\\ncands = []\\nfor c in CLS:\\n    for m in re.finditer(c["pat"], DOC):\\n        cands.append(dict(start=m.start(), end=m.end(), text=m.group(), cat=c["cat"], cid=c["id"],\\n                          conf=0.99, pri=c["pri"], thr=c["thr"], mask=c["mask"], ctype="regex"))\\n\\n# emulated NER PERSON pass (rule CLS-PII-NAME-001)\\nfor m in re.finditer(r"(?:Full Name|Name):\\\\s*([A-Z][a-z]+(?:\\\\s+[A-Z][a-z]+){1,3})", DOC):\\n    cands.append(dict(start=m.start(1), end=m.end(1), text=m.group(1), cat="PII.PERSON_NAME", cid="CLS-PII-NAME-001",\\n                      conf=0.97, pri=5, thr=0.80, mask="[NAME]", ctype="ner"))\\n\\nterms = ["penicillin allergy","allergy","Hypertension","hypertension","prescription adjustment","emergency dispensation","medical dispensation"]\\nlow = DOC.lower()\\nfor t in terms:\\n    s = 0\\n    while True:\\n        i = low.find(t.lower(), s)\\n        if i < 0: break\\n        cands.append(dict(start=i, end=i+len(t), text=DOC[i:i+len(t)], cat="PHI.HEALTH_DATA",\\n                          cid="CLS-PHI-CONDITION-001", conf=0.92, pri=3, thr=0.85, mask="[HEALTH_DATA]", ctype="dictionary_and_heuristic"))\\n        s = i + 1\\n\\n# threshold filter + dedupe\\ncands = [c for c in cands if c["conf"] >= c["thr"]]\\nseen = set(); uniq = []\\nfor c in cands:\\n    k = (c["start"], c["end"], c["cat"], c["cid"])\\n    if k not in seen:\\n        seen.add(k); uniq.append(c)\\n\\n# overlap resolution: start asc, len desc, priority asc, confidence desc\\nuniq.sort(key=lambda c: (c["start"], -(c["end"]-c["start"]), c["pri"], -c["conf"]))\\nkept = []; dropped = []\\nfor c in uniq:\\n    if any(c["start"] < k["end"] and k["start"] < c["end"] for k in kept):\\n        dropped.append(c)\\n    else:\\n        kept.append(c)\\nkept.sort(key=lambda c: c["start"])\\n\\n# contextual checks\\nctx_notes = []\\nout = []\\nfor c in kept:\\n    ctx = DOC[max(0,c["start"]-40):c["start"]]\\n    if c["cid"] == "CLS-PII-DOB-001":\\n        if re.search(r"(?i)(log|timestamp|transaction|record|capture)", ctx) and not re.search(r"(?i)(birth|dob|born)", ctx):\\n            ctx_notes.append(f"{c[\\\'text\\\']} at {c[\\\'start\\\']} classified as administrative timestamp (NON_DOB)"); continue\\n        else:\\n            ctx_notes.append(f"{c[\\\'text\\\']} at {c[\\\'start\\\']} confirmed DOB context")\\n    if c["cid"] == "CLS-PHI-MED-ID-001" and re.search(r"(?i)record id", ctx) and not re.search(r"(?i)(patient|member|medical)", ctx):\\n        ctx_notes.append(f"{c[\\\'text\\\']} at {c[\\\'start\\\']} treated as general log record identifier, not patient medical ref")\\n    out.append(dict(start=c["start"], end=c["end"], text=c["text"], category=c["cat"],\\n                    classifier_id=c["cid"], confidence=round(c["conf"],2), mask_token=c["mask"],\\n                    classifier_type=c["ctype"]))\\n\\nres = dict(active_revision_id="rev-001", ruleset_version="1.0.0", document_length=len(DOC),\\n           total_detections=len(out), detections=out,\\n           counts_per_category=dict(Counter(d["category"] for d in out)),\\n           counts_per_classifier=dict(Counter(d["classifier_id"] for d in out)),\\n           contextual_notes=ctx_notes,\\n           suppressed_overlaps=[{ "text":d["text"], "start":d["start"], "end":d["end"], "classifier_id":d["cid"]} for d in dropped],\\n           categories_with_zero_hits=sorted({c["cat"] for c in CLS} - {d["category"] for d in out}))\\n\\njson.dumps(res, indent=2)\'}, \'extras\': {\'container_id\': \'cntr_6ad47f1ae3908193bb73d32cc81a9e9f0f4b062efa1390cb\'}}, {\'type\': \'server_tool_result\', \'tool_call_id\': \'ci_015ba932ec924b9b006ad47f1b6a0087d185db26bf104a61e4\', \'status\': \'success\'}, {\'type\': \'text\', \'text\': \'```json\\n{\\n  "active_revision_id": "rev-001",\\n  "ruleset_version": "1.0.0",\\n  "document_length": 557,\\n  "total_detections": 6,\\n  "detections": [\\n    {\\n      "start": 233,\\n      "end": 252,\\n      "text": "Jonathan Edward Doe",\\n      "category": "PII.PERSON_NAME",\\n      "classifier_id": "CLS-PII-NAME-001",\\n      "confidence": 0.97,\\n      "mask_token": "[NAME]",\\n      "classifier_type": "ner"\\n    },\\n    {\\n      "start": 280,\\n      "end": 291,\\n      "text": "900-88-2041",\\n      "category": "PII.IDENTIFIER.SSN",\\n      "classifier_id": "CLS-PII-SSN-001",\\n      "confidence": 0.99,\\n      "mask_token": "[SSN]",\\n      "classifier_type": "regex"\\n    },\\n    {\\n      "start": 315,\\n      "end": 334,\\n      "text": "4111-2222-3333-4444",\\n      "category": "PII.FINANCIAL.CREDIT_CARD",\\n      "classifier_