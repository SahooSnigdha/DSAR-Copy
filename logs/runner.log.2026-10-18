IBAN-001", "PII.FINANCIAL.BANK_ACCOUNT", r"\\\\b[A-Z]{2}\\\\d{2}(?:\\\\s?[A-Z0-9]{4}){3,7}\\\\b", 0.90, 2),\\n    ("CLS-PHI-MED-ID-001", "PHI.MEDICAL_IDENTIFIER", r"\\\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\\\b", 0.90, 2),\\n    ("CLS-PII-IP-001", "PII.LOCATION.IP_ADDRESS", r"\\\\b(?:\\\\d{1,3}\\\\.){3}\\\\d{1,3}\\\\b|\\\\b(?:[A-Fa-f0-9]{1,4}:){7}[A-Fa-f0-9]{1,4}\\\\b", 0.90, 3),  # IPv4 and IPv6 simplified\\n    ("CLS-PII-DOB-001", "PII.DEMOGRAPHIC.DATE_OF_BIRTH", r"\\\\b(?:19|20)\\\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\\\d|3[01])\\\\b|\\\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\\\s+(?:0?[1-9]|[12]\\\\d|3[01]),\\\\s+(?:19|20)\\\\d{2}\\\\b", 0.85, 3),\\n    ("CLS-PII-PASSPORT-001", "PII.IDENTIFIER.PASSPORT", r"\\\\b[A-Z]\\\\d{8,9}\\\\b", 0.85, 3),\\n    ("CLS-PII-DL-001", "PII.IDENTIFIER.DRIVERS_LICENSE", r"\\\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\\\b", 0.85, 3),\\n    ("CLS-PII-ADDRESS-001", "PII.LOCATION.STREET_ADDRESS", r"\\\\b\\\\d{1,5}\\\\s+[A-Za-z0-9\\\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\\\s.,#]+)?(?:,\\\\s+[A-Za-z\\\\s]+,\\\\s+[A-Z]{2}\\\\s+\\\\d{5}(?:-\\\\d{4})?)?\\\\b", 0.85, 4),\\n]\\n\\n# Named tuple for detected entities\\nDetectedEntity = namedtuple(\\\'DetectedEntity\\\', [\\\'start\\\', \\\'end\\\', \\\'matched_text\\\', \\\'category\\\', \\\'classifier_id\\\', \\\'confidence\\\', \\\'priority\\\'])\\n\\n# Detect all matches\\nmatches = []\\nfor classifier_id, category, pattern, confidence, priority in regexes:\\n    for match in re.finditer(pattern, document_text):\\n        matches.append(DetectedEntity(match.start(), match.end(), match.group(), category, classifier_id, confidence, priority))\\n\\n# PERSON NER detection proxy\\nperson_pattern = re.compile(r"\\\\b[A-Z][a-z]+(?:\\\\s+[A-Z][a-z]+){1,3}\\\\b")\\npossible_people = []\\n\\nfor match in person_pattern.finditer(document_text):\\n    possible_people.append((match.start(), match.end(), match.group(), "candidate"))\\n\\n# Filter PERSON candidates\\nfor idx, (start, end, text, status) in enumerate(possible_people):\\n    previous_text = document_text[max(0, start - 20):start].strip().lower()\\n    if "full name:" in previous_text:\\n        possible_people[idx] = (start, end, text, "accepted")\\n        matches.append(DetectedEntity(start, end, text, "PII.PERSON_NAME", "CLS-PII-NAME-001", 0.80, 5))\\n    else:\\n        possible_people[idx] = (start, end, text, "rejected-by-context")\\n\\n# Dedupe matches\\nunique_matches = {(m.start, m.end, m.classifier_id): m for m in matches}.values()\\n\\n# Sort by (start asc, length desc, priority asc, confidence desc)\\nsorted_matches = sorted(unique_matches, key=lambda m: (m.start, -(m.end - m.start), m.priority, -m.confidence))\\n\\n# Greedy non-overlapping selection\\nfinal_spans = []\\nlast_end = 0\\nfor match in sorted_matches:\\n    if match.start >= last_end:\\n        final_spans.append(match)\\n        last_end = match.end\\n\\n# Output analysis\\noutput = {\\n    \\\'total_detections\\\': len(final_spans),\\n    \\\'per_category_counts\\\': defaultdict(int),\\n    \\\'final_spans\\\': [],\\n    \\\'overlaps_dropped\\\': sorted(list(set(unique_matches) - set(final_spans)), key=lambda m: m.start)\\n}\\n\\nfor match in final_spans:\\n    output[\\\'per_category_counts\\\'][match.category] += 1\\n    output[\\\'final_spans\\\'].append({\\n        \\\'start\\\': match.start,\\n        \\\'end\\\': match.end,\\n        \\\'matched_text\\\': match.matched_text,\\n        \\\'raw_repr\\\': repr(match.matched_text),\\n        \\\'category\\\': match.category,\\n        \\\'classifier_id\\\': match.classifier_id,\\n        \\\'confidence\\\': match.confidence,\\n        \\\'priority\\\': match.priority,\\n        \\\'suggested_mask_token\\\': match.classifier_id.replace("CLS-", "").replace("-", "_")\\n    })\\n\\n# Generate index ruler\\nruler = \\\'\\\'.join(f"{str(i).rjust(10)}" for i in range(0, len(document_text), 10))\\n\\nlen_document = len(document_text)\\n\\noutput_doc = \\\' \\\'.join(f"{c} {(i % 10 == 9) * \\\'|\\\'}" for i, c in enumerate(document_text))\\n\\n# Verify matches\\nverify_spans = all(document_text[span[\\\'start\\\']:span[\\\'end\\\']] == span[\\\'matched_text\\\'] for span in output[\\\'final_spans\\\'])\\n\\noutput, len_document, verify_spans, output_doc, ruler, possible_people\'}, \'extras\': {\'container_id\': \'cntr_6ad4724a86008193ae6227b87dbfa3da0c1d751e04dad5ae\'}}, {\'type\': \'server_tool_result\', \'tool_call_id\': \'ci_04cea130b2abfa27006ad4724b2ba887d18c888096344d4082\', \'status\': \'success\'}, {\'type\': \'text\', \'text\': \'### Detected Entities\\n\\n- **Total Detections**: 6\\n\\n#### Per Category Counts:\\n- **PII.PERSON_NAME**: 1\\n- **PII.IDENTIFIER.SSN**: 1\\n- **PII.FINANCIAL.CREDIT_CARD**: 1\\n- **PII.CONTACT.EMAIL**: 1\\n- **PII.CONTACT.PHONE_NUMBER**: 1\\n- **PII.LOCATION.STREET_ADDRESS**: 1\\n\\n#### Final Spans:\\n1. **Jonathan Edward Doe**  \\n   - Start: 235, End: 254\\n   - Category: PII.PERSON_NAME\\n   - Classifier: CLS-PII-NAME-001\\n   - Confidence: 0.80\\n   - Priority: 5\\n   - Suggested Mask Token: PII_NAME_001\\n\\n2. **900-88-2041**  \\n   - Start: 282, End: 293\\n   - Category: PII.IDENTIFIER.SSN\\n   - Classifier: CLS-PII-SSN-001\\n   - Confidence: 0.95\\n   - Priority: 1\\n   - Suggested Mask Token: PII_SSN_001\\n\\n3. **4111-2222-3333-4444**  \\n   - Start: 317, End: 336\\n   - Category: PII.FINANCIAL.CREDIT_CARD\\n   - Classifier: CLS-PII-CC-001\\n   - Confidence: 0.95\\n   - Priority: 1\\n   - Suggested Mask Token: PII_CC_001\\n\\n4. **j.doe.secure_test@example-domain.org**  \\n   - Start: 355, End: 391\\n   - Category: PII.CONTACT.EMAIL\\n   - Classifier: CLS-PII-EMAIL-001\\n   - Confidence: 0.95\\n   - Priority: 2\\n   - Suggested Mask Token: PII_EMAIL_001\\n\\n5. **+1 (555) 019-8472**  \\n   - Start: 409, End: 426\\n   - Category: PII.CONTACT.PHONE_NUMBER\\n   - Classifier: CLS-PII-PHONE-001\