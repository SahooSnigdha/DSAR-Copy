, r"\\b(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])\\b|\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+(?:0?[1-9]|[12]\\d|3[01]),\\s+(?:19|20)\\d{2}\\b", 0.85, 3),\r\n    "CLS-PII-PASSPORT-001": ("PII.IDENTIFIER.PASSPORT", r"\\b[A-Z]\\d{8,9}\\b", 0.85, 3),\r\n    "CLS-PII-DL-001": ("PII.IDENTIFIER.DRIVERS_LICENSE", r"\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\b", 0.85, 3),\r\n    "CLS-PII-ADDRESS-001": ("PII.LOCATION.STREET_ADDRESS", r"\\b\\d{1,5}\\s+[A-Za-z0-9\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\s.,#]+)?(?:,\\s+[A-Za-z\\s]+,\\s+[A-Z]{2}\\s+\\d{5}(?:-\\d{4})?)?\\b", 0.85, 4),\r\n}\r\n\r\n# Dictionary terms and NER definitions\r\ndictionary_cls = {"CLS-PHI-CONDITION-001": ["penicillin allergy", "allergy", "Hypertension", "hypertension", "prescription adjustment", "emergency dispensation", "medical dispensation"]}\r\nner_cls = ["CLS-PII-NAME-001"]\r\n\r\n# Record spans for regex classifiers\r\nspan_list = []\r\n\r\n# Regex classifiers\r\nfor classifier_id, (category, pattern, confidence, priority) in patterns.items():\r\n    for match in re.finditer(pattern, document_text):\r\n        start, end = match.span()\r\n        span_list.append({\r\n            "start": start,\r\n            "end": end,\r\n            "matched_text": match.group(),\r\n            "category": category,\r\n            "classifier_id": classifier_id,\r\n            "confidence": confidence,\r\n            "priority": priority,\r\n        })\r\n\r\n# Dictionary term matching\r\nfor classifier_id, terms in dictionary_cls.items():\r\n    category = classifier_id.replace("CLS-", "").replace("-", ".")\r\n    confidence = 0.85\r\n    priority = 3\r\n    for term in terms:\r\n        for match in re.finditer(r\'\\b\' + re.escape(term) + r\'\\b\', document_text):\r\n            start, end = match.span()\r\n            span_list.append({\r\n                "start": start,\r\n                "end": end,\r\n                "matched_text": match.group(),\r\n                "category": category,\r\n                "classifier_id": classifier_id,\r\n                "confidence": confidence,\r\n                "priority": priority,\r\n            })\r\n\r\n# NER - PERSON detection\r\nfor line in document_text.splitlines():\r\n    if "Full Name:" in line:\r\n        match = re.search(r"Full Name:\\s+([A-Z][a-z]*\\s+[A-Z][a-z]*\\s+[A-Z][a-z]*)", line)\r\n        if match:\r\n            start, end = match.span(1)\r\n            span_list.append({\r\n                "start": start,\r\n                "end": end,\r\n                "matched_text": match.group(1),\r\n                "category": "PII.PERSON_NAME",\r\n                "classifier_id": "CLS-PII-NAME-001",\r\n                "confidence": 0.80,\r\n                "priority": 5,\r\n            })\r\n\r\n# Filter, deduplicate, and resolve overlaps\r\nspan_list.sort(key=lambda x: (x["start"], -(x["end"] - x["start"]), x["priority"], -x["confidence"]))\r\n\r\nfinal_spans = []\r\ndropped_spans = []\r\ncurrent_end = 0\r\n\r\nfor span in span_list:\r\n    if span["start"] >= current_end:\r\n        final_spans.append(span)\r\n        current_end = span["end"]\r\n    else:\r\n        dropped_spans.append(span)\r\n\r\n# Count detections\r\ncounts_per_category = defaultdict(int)\r\nfor span in final_spans:\r\n    counts_per_category[span["category"]] += 1\r\n\r\n# Prepare output structure\r\nresult = {\r\n    "final_spans": [{"start": s["start"], "end": s["end"], "matched_text": repr(document_text[s["start"]:s["end"]]), "category": s["category"], "classifier_id": s["classifier_id"], "confidence": s["confidence"], "priority": s["priority"], "mask_token": "MASK"} for s in final_spans],\r\n    "counts_per_category": dict(counts_per_category),\r\n    "total_detections": len(final_spans),\r\n    "dropped_overlaps": len(dropped_spans),\r\n    "offsets_verification": [(s["start"], s["end"], repr(document_text[s["start"]:s["end"]])) for s in final_spans]\r\n}\r\n\r\n# Printing character index ruler\r\nruler = \'\'.join(f\'{i % 10}\' for i in range(len(document_text)))\r\n\r\nruler, result, dropped_spans'}, 'extras': {'container_id': 'cntr_6ad4722ef5608193b05736b872329d88053da1fcb0c55334'}}, {'type': 'server_tool_result', 'tool_call_id': 'ci_02305fd7ff5b86d7006ad4722faa9487d1bc9cc59b45e6cc04', 'status': 'success'}, {'type': 'text', 'text': "Here are the detection results for the document, with character index ruler for verification:\n\n### Character Index Ruler:\n```\n0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901...\n```\n\n### Final Detections:\n1. **Name**: `'==================='`\n   - Start: 14, End: 33\n   - Category: `PII.PERSON_NAME`\n   - Classifier ID: `CLS-PII-NAME-001`\n   - Confidence: `0.80`\n   - Priority: `5`\n\n2. **SSN**: `'900-88-2041'`\n   - Start: 283, End: 294\n   - Category: `PII.IDENTIFIER.SSN`\n   - Classifier ID: `CLS-PII-SSN-001`\n   - Confidence: `0.95`\n   - Priority: `1`\n\n3. **Credit Card**: `'4111-2222-3333-4444'`\n   - Start: 318, End: 337\n   - Category: `PII.FINANCIAL.CREDIT_CARD`\n   - Classifier ID: `CLS-PII-CC-001`\n   - Confidence: `0.95`\n   - Priority: `1`\n\n4. **Email**: `'j.doe.secure_test@example-domain.org'`\n   - Start: 356, End: 392\n   - Category: `PII.CONTACT.EMAIL`\n   - Classifier ID: `CLS-PII-EMAIL-001`\n   - Confidence: `0.95`\n   - Priority: `2`\n\n5. **Phone Number**: `' +1 (555) 019-8472'`\n   - Start: 410, End: 427\n   - Category: `PII.CONTACT.PHONE_NUMBER`\n   - Classifier ID: `CLS-PII-PHONE-001`\n   - Confidence: `0.90`\n   - Priority: `2`\n\n6. **Address**: `'1042 Hidden Valley Road, Seattle, WA 98101'`\n   - Start: 437, End: 479\n   - Category: `PII.LOCATION.STREET_ADDRESS`\n   - Classifier ID: `CLS-PII-ADDRESS-001`\n   - Confidence: `0.85`\n   - Priority: `4`\n\n### Summary:\n- **Total Detections**: 6\n- **Counts per Category**:\n  - `PII.PERSON_NAME`: 1\n  - `PII.IDENTIFIER.SSN`: 1\n  - `PII.FINANCIAL.CREDIT_CARD`: 1\n  - `PII.CONTACT.EMAIL`: 1\n  - `PII.CONTACT.PHONE_NUMBER`: 1\n  - `PII.LOCATION.STREET_ADDRESS`: 1\n- **Dropped Overlaps**: 0\n\n### Offset Verification:\n- SSN: `'900-88-2041'` confirms presence between indices 283-294.\n- Credit Card: `'4111-2222-3333-4444'` confirms presence between indices 318-337.\n- Email: `'j.doe.secure_test@example-domain.org'` confirms presence between indices 356-392.\n- Phone Number: `' +1 (555) 019-8472'` confirms presence between indices 410-427.\n- Address: `'1042 Hidden Valley Road, Seattle, WA 98101'` confirms presence between indices 437-479.\n\nIf you need further details, let me know!", 'annotations': [], 'id': 'msg_02305fd7ff5b86d7006ad4723b75c087d1bf8db3cf988ac866'}]", "user_id": "snigdhasahoo", "Timestamp": "2026-10-18T08:16:16.809349", "source": "HttpServer", "message_type": "Other", "request_id": "request-4"}
