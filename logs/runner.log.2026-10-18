sitive_values = [val for _,_,val,_ in approved] leaks = [v for v in sensitive_values if v in final_text] # also check fragments that would indicate partial leakage of each category frag_checks = { "NAME": ["Jonathan","Edward","Doe"], "SSN": ["900-88","2041"], "CREDIT_CARD": ["4111","2222","3333","4444"], "EMAIL": ["j.doe","example-domain"], "PHONE_NUMBER": ["555","019-8472"], "STREET_ADDRESS": ["Hidden Valley","Seattle","98101"], } for cat, frags in frag_checks.items(): hit = [f for f in frags if f in final_text] frag_leaks[cat] = hit masks_expected = ["[NAME]","[SSN]","[CREDIT_CARD]","[EMAIL]","[PHONE_NUMBER]","[STREET_ADDRESS]"] masks_present = {m: (m in final_text) for m in masks_expected} print("Full-value leaks:", leaks if leaks else "NONE") print("Fragment leaks:", {k:v for k,v in frag_leaks.items() if v} or "NONE") print("Masks present:", masks_present) print("All masks present:", all(masks_present.values())) print("Clean (no full leaks & no frag leaks):", (not leaks) and all(not v for v in frag_leaks.values())) # Metrics print("\n=== METRICS ===") print("Total redactions applied:", len(approved)) print("Preserved fields (skipped/rejected):", 0) print("Final char length:", len(final_text)) ", "user_id": "snigdhasahoo", "Timestamp": "2026-10-18T09:13:30.613406", "source": "HttpServer", "message_type": "Other", "request_id": "request-8"}
