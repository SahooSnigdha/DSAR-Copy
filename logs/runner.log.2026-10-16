{1,4}:){7}[0-9a-fA-F]{1,4}\\b", thr=0.90, pri=3),\n dict(id="CLS-PII-DOB-001", cat="PII.DEMOGRAPHIC.DATE_OF_BIRTH", pat=r"\\b(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])\\b|\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+(?:0?[1-9]|[12]\\d|3[01]),\\s+(?:19|20)\\d{2}\\b", thr=0.85, pri=3),\n dict(id="CLS-PII-IBAN-001", cat="PII.FINANCIAL.BANK_ACCOUNT", pat=r"\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]{4}){3,7}\\b", thr=0.90, pri=2),\n dict(id="CLS-PII-PASSPORT-001", cat="PII.IDENTIFIER.PASSPORT", pat=r"\\b[A-Z]\\d{8,9}\\b", thr=0.85, pri=3),\n dict(id="CLS-PII-DL-001", cat="PII.IDENTIFIER.DRIVERS_LICENSE", pat=r"\\bDL-[A-Z0-9]{6,12}(?:-[A-Z]{2})?\\b", thr=0.85, pri=3),\n dict(id="CLS-PII-ADDRESS-001", cat="PII.LOCATION.STREET_ADDRESS", pat=r"\\b\\d{1,5}\\s+[A-Za-z0-9\\s.,]+(?:Terrace|Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Way|Lane|Ln|Drive|Dr)(?:[A-Za-z0-9\\s.,#]+)?(?:,\\s+[A-Za-z\\s]+,\\s+[A-Z]{2}\\s+\\d{5}(?:-\\d{4})?)?\\b", thr=0.85, pri=4),\n dict(id="CLS-PHI-MED-ID-001", cat="PHI.MEDICAL_IDENTIFIER", pat=r"\\b(?:MC|MEM|PAT|REC)-[A-Za-z0-9-]{4,15}\\b", thr=0.90, pri=2),\n]\n\nterms = ["penicillin allergy","allergy","Hypertension","hypertension","prescription adjustment","emergency dispensation","medical dispensation"]\n\ncands = []\nraw_counts = {}\n\n# 1) Regex classifiers: deterministic full-pattern match => confidence 1.00\nfor c in classifiers:\n    ms = list(re.finditer(c["pat"], doc))\n    raw_counts[c["id"]] = len(ms)\n    for m in ms:\n        cands.append({"start": m.start(), "end": m.end(), "text": m.group(0),\n                      "category": c["cat"], "classifier_id": c["id"],\n                      "confidence": 1.00, "priority": c["pri"], "threshold": c["thr"]})\n\n# 2) Dictionary classifier: case-sensitive exact term match => confidence 1.00\ndt = 0\nfor t in terms:\n    for m in re.finditer(re.escape(t), doc):\n        dt += 1\n        cands.append({"start": m.start(), "end": m.end(), "text": t,\n                      "category": "PHI.HEALTH_DATA", "classifier_id": "CLS-PHI-CONDITION-001",\n                      "confidence": 1.00, "priority": 3, "threshold": 0.85})\nraw_counts["CLS-PHI-CONDITION-001"] = dt\n\n# 3) Deterministic NER simulation for CLS-PII-NAME-001 (entity type PERSON)\n# Step A: anchor-based canonical name extraction (document-derived lexicon, deterministic)\ncanon = [m.group(1).strip() for m in re.finditer(r"Full Name:\\s*(.+)", doc)]\nm1 = re.search(r"My name is\\s+([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)", doc)\nif m1: canon.append(m1.group(1))\nm2 = re.search(r"Emergency contact is\\s+([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)*)", doc)\nif m2: canon.append(m2.group(1))\nprint("CANON_NAMES", canon)\ntitles = {"Mr","Mrs","Ms","Dr"}\nfirsts, lasts = set(), set()\nfor name in canon:\n    parts = [p for p in name.replace(".", " ").split() if p and p not in titles]\n    if parts:\n        firsts.add(parts[0]); lasts.add(parts[-1])\nprint("LEXICON firsts=", sorted(firsts), "lasts=", sorted(lasts))\n\nner_raw = []\n# R1: Title + 1..3 capitalized tokens  (conf 0.95 if >=2 name tokens, 0.85 if exactly 1)\nfor m in re.finditer(r"\\b(?:Mr|Mrs|Ms|Dr)\\.\\s+[A-Z][a-z]+(?:\\s+[A-Z][a-z]+){0,2}\\b", doc):\n    ntok = len(m.group(0).replace(".", " ").split()) - 1\n    conf = 0.85 if ntok == 1 else 0.95\n    ner_raw.append((m.start(), m.end(), m.group(0), conf, "R1"))\n# R2: lexicon first name + 1..2 more capitalized tokens (conf 0.92 for 3 tokens, 0.90 for 2)\nfor f in sorted(firsts):\n    for m in re.finditer(r"\\b" + f + r"(?:\\s+[A-Z][a-z]+){1,2}\\b", doc):\n        ntok = len(m.group(0).split())\n        conf = 0.92 if ntok == 3 else 0.90\n        ner_raw.append((m.start(), m.end(), m.group(0), conf, "R2:"+f))\n# R3: standalone lexicon first name (conf 0.75 -> below threshold 0.80, rejected)\nfor f in sorted(firsts):\n    for m in re.finditer(r"\\b" + f + r"\\b", doc):\n        ner_raw.append((m.start(), m.end(), m.group(0), 0.75, "R3:"+f))\n\naccepted_ner = 0\nrejected = []\nfor (s, e, txt, conf, rule) in ner_raw:\n    if conf >= 0.80:\n        accepted_ner += 1\n        cands.append({"start": s, "end": e, "text": txt,\n                      "category": "PII.PERSON_NAME", "classifier_id": "CLS-PII-NAME-001",\n                      "confidence": conf, "priority": 5, "threshold": 0.80})\n    else:\n        rejected.append({"start": s, "end": e, "text": txt, "confidence": conf, "rule": rule})\nraw_counts["CLS-PII-NAME-001"] = accepted_ner\nprint("RAW_COUNTS", json.dumps(raw_counts))\nprint("REJECTED_BELOW_THRESHOLD", json.dumps(rejected))\n\n# 4) Deduplicate identical (start, end, classifier_id) spans\nseen = {}\nfor c in cands:\n    k = (c["start"], c["end"], c["classifier_id"])\n    if k not in seen or c["confidence"] > seen[k]["confidence"]:\n        seen[k] = c\nuniq = list(seen.values())\n\n# 5) Overlap resolution: sort by (start asc, length desc, priority asc, confidence desc), greedy keep\ndef key(c):\n    return (c["start"], -(c["end"] - c["start"]), c["priority"], -c["confidence"])\nordered = sorted(uniq, key=key)\nkept, dropped = [], []\nfor c in ordered:\n    if any(not (c["end"] <= k["start"] or c["start"] >= k["end"]) for k in kept):\n        dropped.append(c)\n    else:\n        kept.append(c)\nkept.sort(key=lambda c: c["start"])\n\nprint("TOTAL_FINAL", len(kept))\nprint("FINAL_SPANS")\nfor c in kept:\n    print(json.dumps({"start": c["start"], "end": c["end"], "text": c["text"],\n                      "category": c["category"], "classifier_id": c["classifier_id"],\n                      "confidence": round(c["confidence"], 2)}))\nprint("DROPPED_OVERLAPS")\nfor c in dropped:\n    print(json.dumps({"start": c["start"], "end": c["end"], "text": c["text"],\n                      "category": c["category"], "classifier_id": c["classifier_id"],\n                      "confidence": round(c["confidence"], 2)}))\n\ncat_counts = {}\ncid_counts = {}\nfor c in kept:\n    cat_counts[c["category"]] = cat_counts.get(c["category"], 0) + 1\n    cid_counts[c["classifier_id"]] = cid_counts.get(c["classifier_id"], 0) + 1\nprint("CATEGORY_COUNTS", json.dumps(cat_counts))\nprint("CLASSIFIER_COUNTS", json.dumps(cid_counts))'}, 'extras': {'container_id': 'cntr_6ad24d35ecfc8193b634db5f8c9e4ed6005223e1f1621686'}}, {'type': 'server_tool_result', 'tool_call_id': 'ci_0c75321492d612fc006ad24d36c64087d18387897c545dc620', 'status': 'success'}, {'type': 'text', 'text': 'Here\'s the output from the script:\n\n```\nDOC_LEN 2760\nDOC_HEAD \'========================================\'\nDOC_TAIL \'========================================\'\nCANON_NAMES [\'Sarah Elizabeth Jenkins\', \'Dr. Marcus Aurelius Vance\', \'Sarah Jenkins\', \'Elena Vance\']\nLEXICON firsts= [\'Elena\', \'Marcus\', \'Sarah\'] lasts= [\'Jenkins\', \'Vance\']\nRAW_COUNTS {"CLS-PII-SSN-001": 1, "CLS-PII-CC-001": 2, "CLS-PII-EMAIL-001": 3, "CLS-PII-PHONE-001": 5, "CLS-PII-IP-001": 2, "CLS-PII-DOB-001": 4, "CLS-PII-IBAN-001": 2, "CLS-PII-PASSPORT-001": 1, "CLS-PII-DL-001": 1, "CLS-PII-ADDRESS-001": 4, "CLS-PHI-MED-ID-001": 4, "CLS-PHI-CONDITION-001": 5, "CLS-PII-NAME-001": 10}\nREJECTED_BELOW_THRESHOLD [{"start": 2528, "end": 2533, "text": "Elena", "confidence": 0.75, "rule": "R3:Elena"}, {"start": 2000, "end": 2006, "text": "Marcus", "confidence": 0.75, "rule": "R3:Marcus"}, {"start": 325, "end": 330, "text": "Sarah", "confidence": 0.75, "rule": "R3:Sarah"}, {"start": 917, "end": 922, "text": "Sarah", "confidence": 0.75, "rule": "R3:Sarah"}, {"start": 1020, "end": 1025, "text": "Sarah", "confidence": 0.75, "rule": "R3:Sarah"}, {"start": 1245, "end": 1250, "text": "Sarah", "confidence": 0.75, "rule": "R3:Sarah"}, {"start": 1393, "end": 1398, "text": "Sarah", "confidence": 0.75, "rule": "R3:Sarah"}, {"start": 1519, "end": 1524, "text": "Sarah", "confidence": 0.75, "rule": "R3:Sarah"}]\nTOTAL_FINAL 42\nFINAL_SPANS\n{"start": 226, "end": 240, "text": "REC-2026-08912", "category": "PHI.MEDICAL_IDENTIFIER", "classifier_id": "CLS-PHI-MED-ID-001", "