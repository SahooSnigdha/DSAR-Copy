n\n# Prepare detection metadata\ntotal_detections = len(resolved_spans)\ncounts_per_category = {}\nfor span in resolved_spans:\n    category = span["category"]\n    if category not in counts_per_category:\n        counts_per_category[category] = 1\n    else:\n        counts_per_category[category] += 1\n\n# Create output\noutput = {\n    "resolved_spans": resolved_spans,\n    "metadata": {\n        "total_detections": total_detections,\n        "counts_per_category": counts_per_category\n    }\n}\n\n# Print JSON\njson_output = json.dumps(output, indent=2)\nprint(json_output)'}, 'extras': {'container_id': 'cntr_6ad229c77324819380fbc0c4a10a107b0d6ce12e163e32c7'}}, {'type': 'server_tool_result', 'tool_call_id': 'ci_0f18bb220ad336d5006ad229c82d7487d1bbbd3ef68c4a8c1b', 'status': 'success'}, {'type': 'text', 'text': '```json\n{\n  "resolved_spans": [\n    {\n      "start": 0,\n      "end": 7,\n      "matched_text": "Benzene",\n      "category": "chemical",\n      "classifier_id": 1,\n      "confidence": 0.95\n    },\n    {\n      "start": 30,\n      "end": 39,\n      "matched_text": "carcinogen",\n      "category": "risk",\n      "classifier_id": 2,\n      "confidence": 0.9\n    },\n    {\n      "start": 41,\n      "end": 49,\n      "matched_text": "Asbestos",\n      "category": "chemical",\n      "classifier_id": 1,\n      "confidence": 0.92\n    },\n    {\n      "start": 66,\n      "end": 72,\n      "matched_text": "cancer",\n      "category": "risk",\n      "classifier_id": 2,\n      "confidence": 0.88\n    },\n    {\n      "start": 96,\n      "end": 108,\n      "matched_text": "formaldehyde",\n      "category": "chemical",\n      "classifier_id": 1,\n      "confidence": 0.85\n    },\n    {\n      "start": 143,\n      "end": 147,\n      "matched_text": "Lead",\n      "category": "chemical",\n      "classifier_id": 1,\n      "confidence": 0.91\n    },\n    {\n      "start": 148,\n      "end": 157,\n      "matched_text": "poisoning",\n      "category": "risk",\n      "cla