, lasts = set(), set()\\nfor name in canon:\\n    parts = [p for p in name.replace(\\".\\", \\" \\").split() if p and p not in titles]\\n    if parts:\\n        firsts.add(parts[0]); lasts.add(parts[-1])\\nprint(\\"LEXICON firsts=\\", sorted(firsts), \\"lasts=\\", sorted(lasts))\\n\\nner_raw = []\\n# R1: Title + 1..3 capitalized tokens  (conf 0.95 if >=2 name tokens, 0.85 if exactly 1)\\nfor m in re.finditer(r\\"\\\\b(?:Mr|Mrs|Ms|Dr)\\\\.\\\\s+[A-Z][a-z]+(?:\\\\s+[A-Z][a-z]+){0,2}\\\\b\\", doc):\\n    ntok = len(m.group(0).replace(\\".\\", \\" \\").split()) - 1\\n    conf = 0.85 if ntok == 1 else 0.95\\n    ner_raw.append((m.start(), m.end(), m.group(0), conf, \\"R1\\"))\\n# R2: lexicon first name + 1..2 more capitalized tokens (conf 0.92 for 3 tokens, 0.90 for 2)\\nfor f in sorted(firsts):\\n    for m in re.finditer(r\\"\\\\b\\" + f + r\\"(?:\\\\s+[A-Z][a-z]+){1,2}\\\\b\\", doc):\\n        ntok = len(m.group(0).split())\\n        conf = 0.92 if ntok == 3 else 0.90\\n        ner_raw.append((m.start(), m.end(), m.group(0), conf, \\"R2:\\"+f))\\n# R3: standalone lexicon first name (conf 0.75 -> below threshold 0.80, rejected)\\nfor f in sorted(firsts):\\n    for m in re.finditer(r\\"\\\\b\\" + f + r\\"\\\\b\\", doc):\\n        ner_raw.append((m.start(), m.end(), m.group(0), 0.75, \\"R3:\\"+f))\\n\\naccepted_ner = 0\\nrejected = []\\nfor (s, e, txt, conf, rule) in ner_raw:\\n    if conf >= 0.80:\\n        accepted_ner += 1\\n        cands.append({\\"start\\": s, \\"end\\": e, \\"text\\": txt,\\n                      \\"category\\": \\"PII.PERSON_NAME\\", \\"classifier_id\\": \\"CLS-PII-NAME-001\\",\\n                      \\"confidence\\": conf, \\"priority\\": 5, \\"threshold\\": 0.80})\\n    else:\\n        rejected.append({\\"start\\": s, \\"end\\": e, \\"text\\": txt, \\"confidence\\": conf, \\"rule\\": rule})\\nraw_counts[\\"CLS-PII-NAME-001\\"] = accepted_ner\\nprint(\\"RAW_COUNTS\\", json.dumps(raw_counts))\\nprint(\\"REJECTED_BELOW_THRESHOLD\\", json.dumps(rejected))\\n\\n# 4) Deduplicate identical (start, end, classifier_id) spans\\nseen = {}\\nfor c in cands:\\n    k = (c[\\"start\\"], c[\\"end\\"], c[\\"classifier_id\\"])\\n    if k not in seen or c[\\"confidence\\"] > seen[k][\\"confidence\\"]:\\n        seen[k] = c\\nuniq = list(seen.values())\\n\\n# 5) Overlap resolution: sort by (start asc, length desc, priority asc, confidence desc), greedy keep\\ndef key(c):\\n    return (c[\\"start\\"], -(c[\\"end\\"] - c[\\"start\\"]), c[\\"priority\\"], -c[\\"confidence\\"])\\nordered = sorted(uniq, key=key)\\nkept, dropped = [], []\\nfor c in ordered:\\n    if any(not (c[\\"end\\"] <= k[\\"start\\"] or c[\\"start\\"] >= k[\\"end\\"]) for k in kept):\\n        dropped.append(c)\\n    else:\\n        kept.append(c)\\nkept.sort(key=lambda c: c[\\"start\\"])\\n\\nprint(\\"TOTAL_FINAL\\", len(kept))\\nprint(\\"FINAL_SPANS\\")\\nfor c in kept:\\n    print(json.dumps({\\"start\\": c[\\"start\\"], \\"end\\": c[\\"end\\"], \\"text\\": c[\\"text\\"],\\n                      \\"category\\": c[\\"category\\"], \\"classifier_id\\": c[\\"classifier_id\\"],\\n                      \\"confidence\\": round(c[\\"confidence\\"], 2)}))\\nprint(\\"DROPPED_OVERLAPS\\")\\nfor c in dropped:\\n    print(json.dumps({\\"start\\": c[\\"start\\"], \\"end\\": c[\\"end\\"], \\"text\\": c[\\"text\\"],\\n                      \\"category\\": c[\\"category\\"], \\"classifier_id\\": c[\\"classifier_id\\"],\\n                      \\"confidence\\": round(c[\\"confidence\\"], 2)}))\\n\\ncat_counts = {}\\ncid_counts = {}\\nfor c in kept:\\n    cat_counts[c[\\"category\\"]] = cat_counts.get(c[\\"category\\"], 0) + 1\\n    cid_counts[c[\\"classifier_id\\"]] = cid_counts.get(c[\\"classifier_id\\"], 0) + 1\\nprint(\\"CATEGORY_COUNTS\\", json.dumps(cat_counts))\\nprint(\\"CLASSIFIER_COUNTS\\", json.dumps(cid_counts))\\n```\\n\\nPrint everything the script prints, without modification."}}'}
