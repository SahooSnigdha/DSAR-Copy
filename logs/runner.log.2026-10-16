nf, src):\\n    candidates.append({\\"start\\": start, \\"end\\": end, \\"matched_text\\": doc[start:end],\\n                       \\"category\\": cat, \\"classifier_id\\": cid, \\"priority\\": prio,\\n                       \\"confidence\\": conf, \\"source\\": src})\\n\\nfor cid, cat, prio, pat, thr in regex_specs:\\n    for m in re.finditer(pat, doc):\\n        add(m.start(), m.end(), cid, cat, prio, thr, \\"regex\\")\\n\\nDICT_TERMS = [\\"penicillin allergy\\", \\"allergy\\", \\"Hypertension\\", \\"hypertension\\",\\n              \\"prescription adjustment\\", \\"emergency dispensation\\", \\"medical dispensation\\"]\\nfor t in DICT_TERMS:\\n    pat = r\\"(?i)\\\\b\\" + re.escape(t) + r\\"\\\\b\\"\\n    for m in re.finditer(pat, doc):\\n        add(m.start(), m.end(), \\"CLS-PHI-CONDITION-001\\", \\"PHI.HEALTH_DATA\\", 3, 0.85, \\"dictionary\\")\\n\\n# NER emulation (deterministic gazetteer seeded from authoritative in-document name fields)\\nseeds = [m.group(1).strip() for m in re.finditer(r\\"Full Name:\\\\s*(.+)\\", doc)]\\nmec = re.search(r\\"Emergency contact is ([A-Z][a-z]+(?:\\\\s+[A-Z][a-z]+)?)\\", doc)\\nif mec:\\n    seeds.append(mec.group(1))\\nHON = {\\"Dr.\\", \\"Ms.\\", \\"Mr.\\", \\"Mrs.\\", \\"Prof.\\"}\\nvocab, first_names = set(), set()\\nfor s in seeds:\\n    toks = s.split()\\n    names = [t for t in toks if t not in HON]\\n    if names:\\n        vocab.update(names)\\n        first_names.add(names[0])\\nvtoks = []\\nfor m in re.finditer(r\\"(?:Dr|Ms|Mr|Mrs|Prof)\\\\.|[A-Za-z]+\\", doc):\\n    txt = m.group(0)\\n    if txt in HON:\\n        vtoks.append((m.start(), m.end(), txt, \\"hon\\"))\\n    elif txt in vocab:\\n        vtoks.append((m.start(), m.end(), txt, \\"name\\"))\\ni = 0\\nwhile i < len(vtoks):\\n    j = i\\n    while j + 1 < len(vtoks) and vtoks[j+1][0] == vtoks[j][1] + 1 and doc[vtoks[j][1]] == \\" \\":\\n        j += 1\\n    run = vtoks[i:j+1]\\n    i = j + 1\\n    text = doc[run[0][0]:run[-1][1]]\\n    if len(run) >= 2:\\n 